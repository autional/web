    "@autional/tailwind-preset": "0.1.0-rc.10",
    "@autional/tokens": "0.1.0-rc.16",
    "astro": "^5.0.0",
    "i18next": "^26.0.10",
    "lucide-react": "^0.509.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
