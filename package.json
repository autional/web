{
  "name": "@autional/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "gen-static": "node scripts/gen-static.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "prebuild": "pnpm run gen-static && pnpm run check-i18n",
    "predev": "pnpm run gen-static && pnpm run check-i18n",
    "dev": "astro dev --port 13118",
    "build": "astro build",
    "postbuild": "node scripts/check-build.mjs && node scripts/check-links.mjs",
    "preview": "astro preview --port 13118",
    "typecheck": "astro check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@autional/tailwind-preset": "0.1.0-rc.10",
    "@autional/tokens": "0.1.0-rc.16",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "i18next": "^26.0.10",
    "lucide-react": "^0.509.0",
    "mermaid": "^12.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "fontkitten": "^1.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "yaml": "^2.9.1"
  }
}
