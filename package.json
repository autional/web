    "preview": "astro preview --port 13118",
    "typecheck": "astro check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.7.3",
