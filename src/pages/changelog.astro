---
import LandingLayout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { GITHUB_ORG_URL } from '../lib/site-env';

interface ChangelogEntry { date: string; version: string; items: string[] }

// 发布记录口径（CH-01）：只列产品与开源组件的真实发布，不含本站工程日志；
// npm 组件条目以 npm publish time 实查为准（2026-10-05 核对）。
const entries = t('changelog.entries', { returnObjects: true }) as ChangelogEntry[];
// npm 检索页（语言中立）；GitHub 链接依 W6 裁定统一 GITHUB_ORG_URL
const NPM_SEARCH_URL = 'https://www.npmjs.com/search?q=%40autional';
---
<LandingLayout title={t('changelog.meta.title')} description={t('changelog.meta.description')} keywords={t('changelog.meta.keywords')}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold sm:text-5xl">{t('changelog.title')}</h1>
      <p class="mt-4 text-lg text-neutral-500 max-w-xl mx-auto">{t('changelog.leadPrefix')} <a href={NPM_SEARCH_URL} class="text-primary-600 hover:underline">{t('changelog.leadNpm')}</a> {t('changelog.leadMid')} <a href={GITHUB_ORG_URL} class="text-primary-600 hover:underline">{t('changelog.leadGithub')}</a>{t('changelog.leadSuffix')}</p>
    </div>
    <div class="space-y-12">
      {entries.map(v => (
        <div>
          <div class="flex items-baseline gap-3 mb-4">
            <h2 class="text-xl font-bold">{v.version}</h2>
            <time class="text-sm text-neutral-500">{v.date}</time>
          </div>
          <ul class="space-y-2">
            {v.items.map(item => <li class="flex items-start gap-2 text-sm text-neutral-700 dark:text-neutral-300"><span class="text-primary-500 mt-0.5 shrink-0">•</span>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</LandingLayout>
