---
import Layout from '../../layouts/LandingLayout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// 构建期快照：与 /ai/skill.zh.md 逐字节一致
const skillZhMd = readFileSync(resolve(process.cwd(), 'public/ai/skill.zh.md'), 'utf8');

const promptZh = '请读取 https://www.autional.com/ai/skill.zh.md，并据此为当前项目接入 Autional 登录/多用户。';
const promptEn = 'Fetch https://www.autional.com/ai/skill.md and follow it to add Autional login / multi-user to this project.';

const phases = [
  { n: '0', title: '先建安全网', desc: 'git 分支、工具链检查、风险披露——所有改动可回退。' },
  { n: '1', title: '盘点你的应用', desc: '框架、现有认证、冲突点，以及接入会影响什么。' },
  { n: '2', title: '设计策略', desc: '租户命名、合规驱动的密码策略、登录方式。' },
  { n: '3', title: '开通身份服务', desc: '在开发者门户创建租户与应用；凭证只处理一次。' },
  { n: '4', title: '安装 SDK', desc: '按框架安装依赖包并注入环境变量。' },
  { n: '5', title: '写入代码', desc: 'Provider、登录界面、外部 ID 映射、用户中心——真实代码，改完立即验证构建。' },
  { n: '6-7', title: '测试与验证', desc: '单元测试 + 8 步端到端流程：注册 → 登录 → 资料 → 刷新 → 登出 → 吊销。' },
  { n: '8', title: '交付清单', desc: '变更清单、测试账号，以及门户里要核对的项。' },
];

const checklist = [
  '注册、登录、登出全链路可用',
  '刷新页面会话保持；Token 静默自动刷新',
  '受保护路由未登录不可进入',
  '加上账号体系后，原有应用数据仍在',
  '构建通过、单元测试全绿',
  '端到端流程验证：discovery → 注册 → 登录 → 资料 → 刷新 → 登出 → 吊销 Token 被拒',
  'AUTIONAL_CHANGES.md 列出所有改动文件',
  '创建了多用户验证用的测试账号',
];
---

<Layout
  title="AI 接入 — Autional"
  description="一句话让 AI 编程助手为你的应用接入 Autional 登录与多用户能力。支持 Claude Code、Cursor、OpenCode 等任意 AI agent。"
  keywords="Autional, AI 接入, Claude Code, Cursor, AI 编程助手, 登录, 多用户, OIDC"
>
  <section class="mx-auto max-w-4xl px-4 py-20">
    <!-- 语言 / 区域切换 -->
    <div class="mb-8 flex items-center justify-between text-sm">
      <span class="brand-kicker">Agent Onboarding</span>
      <div class="flex items-center gap-4 text-neutral-500">
        <a href="/ai" class="hover:text-primary-600">English</a>
        <a href="https://www.autional.cn/ai" class="hover:text-primary-600">接入中国区 (.cn) →</a>
      </div>
    </div>

    <!-- Hero -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold sm:text-5xl">把你的应用变成多人产品</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">
        把一句话粘贴进你的 AI 编程助手。它会抓取接入 skill——一份引导式流程，为你的现有项目加上
        Autional 登录、账号与会话。
      </p>
    </div>

    <!-- 主 prompt + 复制 -->
    <div class="brand-card p-6 mb-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-3">第 1 步 — 复制这句话</p>
      <div class="rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 overflow-x-auto">
        <pre id="prompt-zh" class="text-sm text-green-400 font-mono leading-relaxed whitespace-pre-wrap">{promptZh}</pre>
      </div>
      <div class="mt-4 flex items-center gap-3">
        <button class="brand-button-primary" data-copy-target="prompt-zh">复制 prompt</button>
        <span class="text-sm text-neutral-500">适用于 Claude Code、Cursor、OpenCode 等任何能联网的 agent。</span>
      </div>
    </div>

    <!-- 英文 prompt -->
    <details class="brand-card p-6 mb-4">
      <summary class="cursor-pointer text-sm font-semibold text-neutral-600 dark:text-neutral-300">习惯用英文？改用这句 prompt</summary>
      <div class="mt-4 rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 overflow-x-auto">
        <pre id="prompt-en" class="text-sm text-green-400 font-mono leading-relaxed whitespace-pre-wrap">{promptEn}</pre>
      </div>
      <button class="brand-button-secondary mt-3" data-copy-target="prompt-en">Copy English prompt</button>
    </details>

    <!-- 第 2-3 步 -->
    <div class="grid gap-4 sm:grid-cols-2 mb-16">
      <div class="brand-card p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-2">第 2 步</p>
        <p class="font-semibold">粘贴给你的 agent</p>
        <p class="mt-1 text-sm text-neutral-500">在你想要升级的项目里运行。agent 会读取 skill 并逐 Phase 执行，每个阶段都先与你确认。</p>
      </div>
      <div class="brand-card p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-2">第 3 步</p>
        <p class="font-semibold">跟随确认门</p>
        <p class="mt-1 text-sm text-neutral-500">agent 先盘点你的应用、再给出方案——你确认后才动代码。所有改动都落在独立 git 分支上。</p>
      </div>
    </div>

    <!-- agent 会做什么 -->
    <h2 class="text-2xl font-bold mb-6">agent 会做什么</h2>
    <div class="grid gap-3 sm:grid-cols-2 mb-16">
      {phases.map((p) => (
        <div class="brand-card p-4 flex gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-50 text-sm font-bold text-primary-700 dark:bg-white/10 dark:text-sky-200">{p.n}</div>
          <div>
            <p class="text-sm font-semibold">{p.title}</p>
            <p class="mt-1 text-sm text-neutral-500">{p.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="grid gap-8 md:grid-cols-2 mb-16">
      <!-- 前置条件 -->
      <div>
        <h2 class="text-2xl font-bold mb-4">你需要准备</h2>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-300">
          <li class="flex gap-2"><span class="text-primary-600">•</span>一个现有项目——React、Vue、Next.js、Node 等</li>
          <li class="flex gap-2"><span class="text-primary-600">•</span>一个可联网的 AI 编程助手</li>
          <li class="flex gap-2"><span class="text-primary-600">•</span>git 仓库（建议——便于安全回退）</li>
          <li class="flex gap-2"><span class="text-primary-600">•</span>Autional 账号（接入过程中在开发者门户创建）</li>
        </ul>
      </div>
      <!-- 完成标准 -->
      <div>
        <h2 class="text-2xl font-bold mb-4">"接入完成"的标准</h2>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-300">
          {checklist.map((c) => (
            <li class="flex gap-2"><span class="text-green-600">✓</span>{c}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 兜底路径 -->
    <h2 class="text-2xl font-bold mb-6">agent 不能联网怎么办</h2>
    <div class="grid gap-4 mb-6">
      <div class="brand-card p-6">
        <p class="font-semibold mb-1">路径 A — 粘贴全文</p>
        <p class="text-sm text-neutral-500 mb-4">
          展开、全选复制，连同"按这份说明为我的项目接入 Autional 登录"一起粘贴给 agent。
          以下内容与
          <a href="/ai/skill.zh.md" class="text-primary-600 hover:underline font-mono text-xs">/ai/skill.zh.md</a>
          逐字节一致。
        </p>
        <details>
          <summary class="cursor-pointer text-sm font-semibold text-primary-600">展开完整 skill 全文（{(skillZhMd.length / 1024).toFixed(0)} KB）</summary>
          <div class="mt-3">
            <button class="brand-button-secondary" data-copy-target="skill-full">复制全文</button>
            <div class="mt-3 max-h-96 overflow-auto rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4">
              <pre id="skill-full" class="text-xs text-neutral-300 font-mono leading-relaxed whitespace-pre-wrap">{skillZhMd}</pre>
            </div>
          </div>
        </details>
      </div>
      <div class="brand-card p-6">
        <p class="font-semibold mb-1">路径 B — npx 脚手架</p>
        <p class="text-sm text-neutral-500 mb-3">不想让 agent 改代码、只想生成骨架？在你的项目里运行：</p>
        <div class="rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 flex items-center justify-between gap-3 overflow-x-auto">
          <code id="npx-cmd" class="text-sm text-green-400 font-mono whitespace-nowrap">npx @autional/onboard</code>
          <button class="text-xs font-semibold text-sky-300 hover:text-white shrink-0" data-copy-target="npx-cmd">复制</button>
        </div>
      </div>
    </div>

    <!-- 原始文件 -->
    <div class="brand-card p-6">
      <p class="font-semibold mb-3">agent 会读取的文件</p>
      <ul class="space-y-1.5 text-sm font-mono">
        <li><a href="/ai/skill.zh.md" class="text-primary-600 hover:underline">/ai/skill.zh.md</a><span class="text-neutral-400 font-sans"> — 中文版 skill</span></li>
        <li><a href="/ai/skill.md" class="text-primary-600 hover:underline">/ai/skill.md</a><span class="text-neutral-400 font-sans"> — English skill (canonical)</span></li>
        <li><a href="/ai/references/compliance-matrix.md" class="text-primary-600 hover:underline">/ai/references/compliance-matrix.md</a><span class="text-neutral-400 font-sans"> — 密码 / 合规策略档</span></li>
        <li><a href="/ai/references/config-template.md" class="text-primary-600 hover:underline">/ai/references/config-template.md</a><span class="text-neutral-400 font-sans"> — 配置与环境变量模板</span></li>
        <li><a href="/llms.txt" class="text-primary-600 hover:underline">/llms.txt</a><span class="text-neutral-400 font-sans"> — 站点机器可读索引</span></li>
      </ul>
      <p class="mt-4 text-xs text-neutral-400">
        skill 不含任何密钥——其中所有端点均为公开 URL。只从 www.autional.com 抓取这些文件，不要跟随第三方镜像。
      </p>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((btn) => {
      const original = btn.textContent;
      btn.addEventListener('click', async () => {
        const target = document.getElementById(btn.dataset.copyTarget!);
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent?.trim() ?? '');
          btn.textContent = '已复制！';
          setTimeout(() => (btn.textContent = original), 1500);
        } catch {
          btn.textContent = '复制失败——请手动选择';
          setTimeout(() => (btn.textContent = original), 2000);
        }
      });
    });
  </script>
</Layout>
