---
import Layout from '../../layouts/LandingLayout.astro';
import LoginApp from '../../components/ai-login/LoginApp.tsx';
import { t } from '../../i18n';

const title = t('aiLogin.metaTitle');
const description = t('aiLogin.metaDescription');
---

<Layout title={title} description={description} noIndex={true}>
  <LoginApp client:load />

  <noscript>
    <p class="mx-auto max-w-xl px-4 py-10 text-center text-sm text-neutral-600 dark:text-neutral-300">
      {t('aiLogin.noscript')}
    </p>
  </noscript>
</Layout>
