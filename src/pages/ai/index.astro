---
import Layout from '../../layouts/LandingLayout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { t } from '../../i18n';
import { CDN_HOST, DEFAULT_LANG, LOCALE, OTHER_REGION_SITE_URL, SITE_HOST, SITE_URL } from '../../lib/site-env';

interface Phase { n: string; title: string; desc: string }

// 构建期快照：与 /ai/skill.md 逐字节一致（gen-static 已按本区默认语言从入仓镜像落位）
const skillMd = readFileSync(resolve(process.cwd(), 'public/ai/skill.md'), 'utf8');

// W3：每区只保留 /ai/ 主页（cn=zh / com=en），语言变体页退场——本文语言随 DEFAULT_LANG
const otherLang = DEFAULT_LANG === 'zh' ? 'en' : 'zh';
const otherLocale = DEFAULT_LANG === 'zh' ? 'en-US' : 'zh-CN';
const skillMain = `${SITE_URL}/ai/skill.md`;
const skillMainFallback = `${CDN_HOST}/ai/latest/SKILL.md`;
const skillOther = `${SITE_URL}/ai/skill.${otherLang}.md`;
const skillOtherFallback = `${CDN_HOST}/ai/latest/SKILL.${otherLang}.md`;
const skillMirror = `${CDN_HOST}/ai/latest/SKILL.md`;
const otherSkillPath = `/ai/skill.${otherLang}.md`;

// hreflang 互指（T-03 / W3）：本区 /ai/（DEFAULT_LANG 主）与对侧区 /ai/ 互指，x-default 指本区主版本
const alternates = [
  { hreflang: LOCALE, href: `${SITE_URL}/ai/` },
  { hreflang: otherLocale, href: `${OTHER_REGION_SITE_URL}/ai/` },
  { hreflang: 'x-default', href: `${SITE_URL}/ai/` },
];

const phases = t('ai.phases', { returnObjects: true }) as Phase[];
const reqItems = t('ai.reqItems', { returnObjects: true }) as string[];
const checklist = t('ai.checklist', { returnObjects: true }) as string[];
---

<Layout
  title={t('ai.meta.title')}
  description={t('ai.meta.description')}
  keywords={t('ai.meta.keywords')}
  alternates={alternates}
>
  <section
    class="mx-auto max-w-4xl px-4 py-20"
    data-copy-ok={t('ai.copyOk')}
    data-copy-fail={t('ai.copyFail')}
  >
    <!-- 语言 / 区域切换 -->
    <div class="mb-8 flex items-center justify-between text-sm">
      <span class="brand-kicker">{t('ai.kicker')}</span>
      <div class="flex items-center gap-4 text-neutral-500">
        <a href={`${OTHER_REGION_SITE_URL}/ai`} class="hover:text-primary-600">{t('ai.regionSwitch')}</a>
      </div>
    </div>

    <!-- Hero -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold sm:text-5xl">{t('ai.heroTitle')}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">{t('ai.heroLead')}</p>
    </div>

    <!-- 主 prompt + 复制 -->
    <div class="brand-card p-6 mb-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-3">{t('ai.step1Label')}</p>
      <div class="rounded-xl bg-code border border-neutral-700 p-4 overflow-x-auto">
        <pre id="prompt-main" class="text-sm text-syntax-plain font-mono leading-relaxed whitespace-pre-wrap">{t('ai.promptPrimary', { url: skillMain, fallback: skillMainFallback })}</pre>
      </div>
      <div class="mt-4 flex items-center gap-3">
        <button class="brand-button-primary" data-copy-target="prompt-main">{t('ai.copyPrimary')}</button>
        <span class="text-sm text-neutral-500">{t('ai.agentNote')}</span>
      </div>
    </div>

    <!-- 次级语言 prompt -->
    <details class="brand-card p-6 mb-4">
      <summary class="cursor-pointer text-sm font-semibold text-neutral-600 dark:text-neutral-300">{t('ai.promptSecondarySummary')}</summary>
      <div class="mt-4 rounded-xl bg-code border border-neutral-700 p-4 overflow-x-auto">
        <pre id="prompt-secondary" class="text-sm text-syntax-plain font-mono leading-relaxed whitespace-pre-wrap">{t('ai.promptSecondary', { url: skillOther, fallback: skillOtherFallback })}</pre>
      </div>
      <button class="brand-button-secondary mt-3" data-copy-target="prompt-secondary">{t('ai.copySecondary')}</button>
    </details>

    <!-- 第 2-3 步 -->
    <div class="grid gap-4 sm:grid-cols-2 mb-16">
      <div class="brand-card p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-2">{t('ai.step2Title')}</p>
        <p class="font-semibold">{t('ai.step2Head')}</p>
        <p class="mt-1 text-sm text-neutral-500">{t('ai.step2Desc')}</p>
      </div>
      <div class="brand-card p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-2">{t('ai.step3Title')}</p>
        <p class="font-semibold">{t('ai.step3Head')}</p>
        <p class="mt-1 text-sm text-neutral-500">{t('ai.step3Desc')}</p>
      </div>
    </div>

    <!-- agent 会做什么 -->
    <h2 class="text-2xl font-bold mb-6">{t('ai.phasesTitle')}</h2>
    <div class="grid gap-3 sm:grid-cols-2 mb-16">
      {phases.map((p) => (
        <div class="brand-card p-4 flex gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-50 text-sm font-bold text-primary-700 dark:bg-white/10 dark:text-sky-200">{p.n}</div>
          <div>
            <p class="text-sm font-semibold">{p.title}</p>
            <p class="mt-1 text-sm text-neutral-500">{p.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="grid gap-8 md:grid-cols-2 mb-16">
      <!-- 前置条件 -->
      <div>
        <h2 class="text-2xl font-bold mb-4">{t('ai.reqTitle')}</h2>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-300">
          {reqItems.map((r) => (
            <li class="flex gap-2"><span class="text-primary-600">•</span>{r}</li>
          ))}
        </ul>
      </div>
      <!-- 完成标准 -->
      <div>
        <h2 class="text-2xl font-bold mb-4">{t('ai.checklistTitle')}</h2>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-300">
          {checklist.map((c) => (
            <li class="flex gap-2"><span class="text-green-600">✓</span>{c}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 兜底路径 -->
    <h2 class="text-2xl font-bold mb-6">{t('ai.fallbacksTitle')}</h2>
    <div class="grid gap-4 mb-6">
      <div class="brand-card p-6">
        <p class="font-semibold mb-1">{t('ai.optATitle')}</p>
        <p class="text-sm text-neutral-500 mb-4">
          {t('ai.optADescA')}
          <a href="/ai/skill.md" class="text-primary-600 hover:underline font-mono text-xs">/ai/skill.md</a>
          {t('ai.optADescB')}
        </p>
        <details>
          <summary class="cursor-pointer text-sm font-semibold text-primary-600">{t('ai.optAToggle', { kb: (skillMd.length / 1024).toFixed(0) })}</summary>
          <div class="mt-3">
            <button class="brand-button-secondary" data-copy-target="skill-full">{t('ai.copyFull')}</button>
            <div class="mt-3 max-h-96 overflow-auto rounded-xl bg-code border border-neutral-700 p-4">
              <pre id="skill-full" class="text-xs text-neutral-300 font-mono leading-relaxed whitespace-pre-wrap">{skillMd}</pre>
            </div>
          </div>
        </details>
      </div>
      <div class="brand-card p-6">
        <p class="font-semibold mb-1">{t('ai.optBTitle')}</p>
        <p class="text-sm text-neutral-500 mb-3">{t('ai.optBDesc')}</p>
        <div class="rounded-xl bg-code border border-neutral-700 p-4 flex items-center justify-between gap-3 overflow-x-auto">
          <code id="npx-cmd" class="text-sm text-syntax-plain font-mono whitespace-nowrap">{t('ai.optBCmd')}</code>
          <button class="text-xs font-semibold text-sky-300 hover:text-white shrink-0" data-copy-target="npx-cmd">{t('ai.copyShort')}</button>
        </div>
      </div>
      <div class="brand-card p-6">
        <p class="font-semibold mb-1">{t('ai.optCTitle')}</p>
        <p class="text-sm text-neutral-500 mb-3">{t('ai.optCDesc')}</p>
        <div class="rounded-xl bg-code border border-neutral-700 p-4 overflow-x-auto">
          <code id="cdn-url" class="text-sm text-syntax-plain font-mono whitespace-nowrap">{skillMirror}</code>
        </div>
        <button class="brand-button-secondary mt-3" data-copy-target="cdn-url">{t('ai.copyMirror')}</button>
      </div>
    </div>

    <!-- 原始文件 -->
    <div class="brand-card p-6">
      <p class="font-semibold mb-3">{t('ai.filesTitle')}</p>
      <ul class="space-y-1.5 text-sm font-mono">
        <li><a href="/ai/skill.md" class="text-primary-600 hover:underline">/ai/skill.md</a><span class="text-neutral-400 font-sans"> — {t('ai.filesMainLabel')}</span></li>
        <li><a href={otherSkillPath} class="text-primary-600 hover:underline">{otherSkillPath}</a><span class="text-neutral-400 font-sans"> — {t('ai.filesOtherLabel')}</span></li>
        <li><a href="/ai/references/compliance-matrix.md" class="text-primary-600 hover:underline">/ai/references/compliance-matrix.md</a><span class="text-neutral-400 font-sans"> — {t('ai.filesComplianceLabel')}</span></li>
        <li><a href="/ai/references/config-template.md" class="text-primary-600 hover:underline">/ai/references/config-template.md</a><span class="text-neutral-400 font-sans"> — {t('ai.filesConfigLabel')}</span></li>
        <li><a href="/llms.txt" class="text-primary-600 hover:underline">/llms.txt</a><span class="text-neutral-400 font-sans"> — {t('ai.filesLlmsLabel')}</span></li>
      </ul>
      <p class="mt-4 text-xs text-neutral-400">{t('ai.filesNote', { host: SITE_HOST })}</p>
    </div>
  </section>

  <script>
    // 复制反馈文案随区域语言（SSR 注入 data-*，避免在客户端脚本里散语言字面量）
    const holder = document.querySelector<HTMLElement>('[data-copy-ok]');
    const copyOk = holder?.dataset.copyOk ?? 'Copied!';
    const copyFail = holder?.dataset.copyFail ?? 'Copy failed';
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((btn) => {
      const original = btn.textContent;
      btn.addEventListener('click', async () => {
        const target = document.getElementById(btn.dataset.copyTarget!);
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent?.trim() ?? '');
          btn.textContent = copyOk;
          setTimeout(() => (btn.textContent = original), 1500);
        } catch {
          btn.textContent = copyFail;
          setTimeout(() => (btn.textContent = original), 2000);
        }
      });
    });
  </script>
</Layout>
