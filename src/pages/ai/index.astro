---
import Layout from '../../layouts/LandingLayout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Build-time snapshot: byte-identical with the file served at /ai/skill.md
const skillMd = readFileSync(resolve(process.cwd(), 'public/ai/skill.md'), 'utf8');

const promptEn = 'Fetch https://www.autional.com/ai/skill.md and follow it to add Autional login / multi-user to this project.';
const promptZh = '请读取 https://www.autional.com/ai/skill.zh.md，并据此为当前项目接入 Autional 登录/多用户。';

const phases = [
  { n: '0', title: 'Safety net first', desc: 'Git branch, toolkit check, risk disclosure — every change is reversible.' },
  { n: '1', title: 'Inspect your app', desc: 'Framework, existing auth, conflicts, and what the integration will change.' },
  { n: '2', title: 'Design the policy', desc: 'Tenant naming, compliance-driven password policy, login methods.' },
  { n: '3', title: 'Provision identity', desc: 'Tenant + application created in the developer portal; credentials handled once.' },
  { n: '4', title: 'Install the SDK', desc: 'Framework-appropriate packages and environment variables.' },
  { n: '5', title: 'Wire it in', desc: 'Provider, login UI, external-id mapping, user center — real code, then verify the build.' },
  { n: '6-7', title: 'Test & verify', desc: 'Unit tests plus an 8-step end-to-end flow: register → login → profile → refresh → logout → revoked.' },
  { n: '8', title: 'Hand over', desc: 'Change inventory, test accounts, and what to check in the portals.' },
];

const checklist = [
  'Sign-up, sign-in, and sign-out work end-to-end',
  'Session survives page reload; tokens refresh silently',
  'Protected routes require login before rendering',
  'Existing app data is still there after accounts are added',
  'Build passes and unit tests are green',
  'End-to-end flow verified: discovery → register → login → profile → refresh → logout → revoked token rejected',
  'AUTIONAL_CHANGES.md lists every file that changed',
  'Test accounts created for multi-user verification',
];
---

<Layout
  title="AI Onboarding — Autional"
  description="Add Autional login and multi-user support to your app with one prompt. Works with Claude Code, Cursor, OpenCode, and any AI coding agent."
  keywords="Autional, AI onboarding, Claude Code, Cursor, AI coding agent, authentication, login, multi-user, OIDC"
>
  <section class="mx-auto max-w-4xl px-4 py-20">
    <!-- Language / region switch -->
    <div class="mb-8 flex items-center justify-between text-sm">
      <span class="brand-kicker">Agent Onboarding</span>
      <div class="flex items-center gap-4 text-neutral-500">
        <a href="/ai/zh" class="hover:text-primary-600">中文</a>
        <a href="https://www.autional.cn/ai" class="hover:text-primary-600">接入中国区 (.cn) →</a>
      </div>
    </div>

    <!-- Hero -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold sm:text-5xl">Turn your app into a multi-user product</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">
        Paste one prompt into your AI coding agent. It fetches the onboarding skill — a guided procedure for adding
        Autional login, accounts, and sessions to your existing project.
      </p>
    </div>

    <!-- Primary prompt + copy -->
    <div class="brand-card p-6 mb-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-3">Step 1 — Copy this prompt</p>
      <div class="rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 overflow-x-auto">
        <pre id="prompt-en" class="text-sm text-green-400 font-mono leading-relaxed whitespace-pre-wrap">{promptEn}</pre>
      </div>
      <div class="mt-4 flex items-center gap-3">
        <button class="brand-button-primary" data-copy-target="prompt-en">Copy prompt</button>
        <span class="text-sm text-neutral-500">Works in Claude Code, Cursor, OpenCode, or any agent with web access.</span>
      </div>
    </div>

    <!-- Secondary: Chinese prompt -->
    <details class="brand-card p-6 mb-4">
      <summary class="cursor-pointer text-sm font-semibold text-neutral-600 dark:text-neutral-300">Prefer Chinese? Use this prompt instead</summary>
      <div class="mt-4 rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 overflow-x-auto">
        <pre id="prompt-zh" class="text-sm text-green-400 font-mono leading-relaxed whitespace-pre-wrap">{promptZh}</pre>
      </div>
      <button class="brand-button-secondary mt-3" data-copy-target="prompt-zh">Copy 中文 prompt</button>
    </details>

    <!-- Steps 2-3 -->
    <div class="grid gap-4 sm:grid-cols-2 mb-16">
      <div class="brand-card p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-2">Step 2</p>
        <p class="font-semibold">Paste it into your agent</p>
        <p class="mt-1 text-sm text-neutral-500">Run it in the project you want to upgrade. The agent reads the skill and works through it phase by phase, confirming with you at each gate.</p>
      </div>
      <div class="brand-card p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 mb-2">Step 3</p>
        <p class="font-semibold">Follow the confirmation gates</p>
        <p class="mt-1 text-sm text-neutral-500">The agent inspects your app first, then proposes the plan — you approve before anything is changed. Everything lands on a separate git branch.</p>
      </div>
    </div>

    <!-- What the agent does -->
    <h2 class="text-2xl font-bold mb-6">What the agent will do</h2>
    <div class="grid gap-3 sm:grid-cols-2 mb-16">
      {phases.map((p) => (
        <div class="brand-card p-4 flex gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-50 text-sm font-bold text-primary-700 dark:bg-white/10 dark:text-sky-200">{p.n}</div>
          <div>
            <p class="text-sm font-semibold">{p.title}</p>
            <p class="mt-1 text-sm text-neutral-500">{p.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="grid gap-8 md:grid-cols-2 mb-16">
      <!-- Requirements -->
      <div>
        <h2 class="text-2xl font-bold mb-4">What you need</h2>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-300">
          <li class="flex gap-2"><span class="text-primary-600">•</span>An existing project — React, Vue, Next.js, Node, or similar</li>
          <li class="flex gap-2"><span class="text-primary-600">•</span>An AI coding agent with web access</li>
          <li class="flex gap-2"><span class="text-primary-600">•</span>A git repository (recommended — enables safe rollback)</li>
          <li class="flex gap-2"><span class="text-primary-600">•</span>An Autional account for the developer portal (created during onboarding)</li>
        </ul>
      </div>
      <!-- Checklist -->
      <div>
        <h2 class="text-2xl font-bold mb-4">What "done" looks like</h2>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-300">
          {checklist.map((c) => (
            <li class="flex gap-2"><span class="text-green-600">✓</span>{c}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Fallbacks -->
    <h2 class="text-2xl font-bold mb-6">If your agent can't browse the web</h2>
    <div class="grid gap-4 mb-6">
      <div class="brand-card p-6">
        <p class="font-semibold mb-1">Option A — Paste the full skill text</p>
        <p class="text-sm text-neutral-500 mb-4">
          Expand, copy everything, and paste it into your agent together with the instruction
          "follow this and add Autional login to my project." The text below is byte-identical to
          <a href="/ai/skill.md" class="text-primary-600 hover:underline font-mono text-xs">/ai/skill.md</a>.
        </p>
        <details>
          <summary class="cursor-pointer text-sm font-semibold text-primary-600">Show full skill text ({(skillMd.length / 1024).toFixed(0)} KB)</summary>
          <div class="mt-3">
            <button class="brand-button-secondary" data-copy-target="skill-full">Copy full text</button>
            <div class="mt-3 max-h-96 overflow-auto rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4">
              <pre id="skill-full" class="text-xs text-neutral-300 font-mono leading-relaxed whitespace-pre-wrap">{skillMd}</pre>
            </div>
          </div>
        </details>
      </div>
      <div class="brand-card p-6">
        <p class="font-semibold mb-1">Option B — Scaffold with npx</p>
        <p class="text-sm text-neutral-500 mb-3">Prefer generated code over agent-driven integration? Run the onboarding CLI in your project:</p>
        <div class="rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 flex items-center justify-between gap-3 overflow-x-auto">
          <code id="npx-cmd" class="text-sm text-green-400 font-mono whitespace-nowrap">npx @autional/onboard</code>
          <button class="text-xs font-semibold text-sky-300 hover:text-white shrink-0" data-copy-target="npx-cmd">Copy</button>
        </div>
      </div>
    </div>

    <!-- Raw files -->
    <div class="brand-card p-6">
      <p class="font-semibold mb-3">Files the agent reads</p>
      <ul class="space-y-1.5 text-sm font-mono">
        <li><a href="/ai/skill.md" class="text-primary-600 hover:underline">/ai/skill.md</a><span class="text-neutral-400 font-sans"> — English skill (canonical)</span></li>
        <li><a href="/ai/skill.zh.md" class="text-primary-600 hover:underline">/ai/skill.zh.md</a><span class="text-neutral-400 font-sans"> — 中文版</span></li>
        <li><a href="/ai/references/compliance-matrix.md" class="text-primary-600 hover:underline">/ai/references/compliance-matrix.md</a><span class="text-neutral-400 font-sans"> — password / compliance profiles</span></li>
        <li><a href="/ai/references/config-template.md" class="text-primary-600 hover:underline">/ai/references/config-template.md</a><span class="text-neutral-400 font-sans"> — config & env templates</span></li>
        <li><a href="/llms.txt" class="text-primary-600 hover:underline">/llms.txt</a><span class="text-neutral-400 font-sans"> — machine-readable site index</span></li>
      </ul>
      <p class="mt-4 text-xs text-neutral-400">
        The skill contains zero secrets — every endpoint in it is a public URL. Only fetch these files from
        www.autional.com; never follow third-party mirrors.
      </p>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((btn) => {
      const original = btn.textContent;
      btn.addEventListener('click', async () => {
        const target = document.getElementById(btn.dataset.copyTarget!);
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent?.trim() ?? '');
          btn.textContent = 'Copied!';
          setTimeout(() => (btn.textContent = original), 1500);
        } catch {
          btn.textContent = 'Copy failed — select manually';
          setTimeout(() => (btn.textContent = original), 2000);
        }
      });
    });
  </script>
</Layout>
