---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/LandingLayout.astro';
import { t } from '../../i18n';
import { isRegionPost, postSlug } from '../../lib/blog-lang';
import { SITE_URL } from '../../lib/site-env';
import '../../styles/blog-diagrams.css';

type DataFilter = { data: CollectionEntry<'blog'>['data'] };

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: DataFilter) => data.status === 'verified');
  return posts
    .filter((post: CollectionEntry<'blog'>) => isRegionPost(post.id))
    .map((post: CollectionEntry<'blog'>) => ({
      params: { slug: postSlug(post.id) },
      props: { post },
    }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { data } = post;
const { Content } = await post.render();

const categoryLabel = t(`blog.categories.${data.category.toLowerCase()}`);

// 相关阅读（L-04）：同分类 + 标签重合度排序，取前 3（限本区语言目录）
const allPosts = await getCollection('blog', ({ data: d }: DataFilter) => d.status === 'verified');
const related = allPosts
  .filter((p: CollectionEntry<'blog'>) => isRegionPost(p.id) && p.id !== post.id)
  .map((p: CollectionEntry<'blog'>) => ({
    post: p,
    score: (p.data.category === data.category ? 2 : 0) + p.data.tags.filter((t: string) => data.tags.includes(t)).length,
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.post);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.excerpt,
  datePublished: data.date,
  author: { '@type': 'Organization', name: 'Autional' },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('blog.breadcrumbHome'), item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: t('blog.title'), item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: categoryLabel, item: `${SITE_URL}/blog?cat=${encodeURIComponent(data.category)}` },
    { '@type': 'ListItem', position: 4, name: data.title },
  ],
};

const keywords = ['Autional', t('blog.keywordIdentity'), t('blog.keywordAuth'), data.category, ...data.tags].join(', ');
---

<Layout
  title={`${data.title} — ${t('blog.metaTitleSuffix')}`}
  description={data.excerpt}
  ogType="article"
  image={`/og/blog/${postSlug(post.id)}.png`}
  keywords={keywords}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-neutral-500 dark:text-[var(--color-text-muted)]" aria-label={t('a11y.breadcrumb')}>
      <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-2 font-medium text-neutral-700 transition-colors hover:border-primary-200 hover:text-primary-700 dark:border-neutral-800 dark:bg-surface dark:text-neutral-300 dark:hover:border-primary-700 dark:hover:text-white">
        <span aria-hidden="true">&larr;</span>
        {t('blog.backToList')}
      </a>
      <span>/</span>
      <a href="/blog" class="hover:text-primary-600">{t('blog.title')}</a>
      <span>/</span>
      <span>{data.category}</span>
    </nav>
    <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-500">
      <span class="rounded-full bg-primary-50 dark:bg-primary-900/30 px-3 py-1 text-xs font-medium text-primary-700">{data.category}</span>
      <time datetime={data.date}>{data.date}</time>
      <span>{data.readTime}</span>
      {data.tags.map((tag: string) => <span>#{tag}</span>)}
    </div>
    <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">{data.title}</h1>
    <div class="mt-8 prose prose-lg dark:prose-invert max-w-none"><Content /></div>
    {related.length > 0 && (
      <section class="mt-16 border-t border-neutral-200 pt-8 dark:border-neutral-800">
        <h2 class="text-xl font-bold">{t('blog.relatedReading')}</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {related.map((r: CollectionEntry<'blog'>) => (
            <a href={`/blog/${postSlug(r.id)}`} class="group rounded-xl border border-neutral-200 p-5 transition-all dark:border-neutral-800 hover:border-neutral-300">
              <span class="rounded-full bg-primary-50 dark:bg-primary-900/30 px-2.5 py-0.5 text-xs font-medium text-primary-700">{r.data.category}</span>
              <h3 class="mt-3 text-sm font-semibold group-hover:text-primary-600">{r.data.title}</h3>
              <p class="mt-2 text-xs text-neutral-500">{r.data.date} · {r.data.readTime}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-12 rounded-md bg-primary-900 px-8 py-10 text-white">
      <h2 class="text-2xl font-bold">{t('blog.ctaTitle')}</h2>
      <p class="mt-3 text-sm leading-7 text-sky-100/82">{t('blog.ctaDesc')}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/docs" class="inline-flex items-center justify-center rounded-full bg-white px-6 py-2.5 text-sm font-semibold text-primary-700 transition hover:bg-sky-50">{t('blog.ctaDocs')}</a>
        <a href="/features" class="inline-flex items-center justify-center rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10">{t('blog.ctaFeatures')}</a>
      </div>
    </section>

    <div class="mt-12 border-t border-neutral-200 pt-6 dark:border-neutral-800">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm font-medium text-primary-600 transition-colors hover:text-primary-700">
        <span aria-hidden="true">&larr;</span>
        {t('blog.backToAll')}
      </a>
    </div>
  </article>
  <script>
    import { initMermaidDiagrams } from '../../lib/mermaid-diagrams';
    void initMermaidDiagrams();
  </script>
</Layout>
