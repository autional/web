---
import Layout from '../layouts/LandingLayout.astro';
const steps = [
  { icon: '1', title: '启动平台', code: `# 完整步骤见快速开始指南：https://developer.autional.cn/quickstart\ndocker compose -f docker-compose.infra.yml -f docker-compose.monolith.yml up -d\n\n# 等待约 2-3 分钟，全部 27 个服务启动`, lang: 'bash' },
  { icon: '2', title: '安装 SDK', code: `npm install @autional/react`, lang: 'bash' },
  { icon: '3', title: '为你的应用接入认证', code: `import { AutionalProvider } from '@autional/react';\n\nconst config = { appId: 'my-app', issuer: 'https://api.autional.cn' };\n\nfunction App() {\n  return (\n    <AutionalProvider config={config}>\n      <YourApp />\n    </AutionalProvider>\n  );\n}`, lang: 'tsx' },
  { icon: '4', title: '本地演示与控制台', code: `# 查看本地服务状态\ndocker compose ps\n\n# 管理控制台：http://localhost:11001\n# 示例账号（仅限本地演示，请勿用于生产）：admin@admin.com / admin123`, lang: 'bash' },
];
const apis = [
  { svc: 'Identity', port: 11001, desc: '认证、注册、密码管理、SSO、RBAC', path: '/api/v1/auth/login' },
  { svc: 'MFA', port: 11005, desc: 'TOTP、WebAuthn/FIDO2、短信、邮件 OTP、自适应 MFA', path: '/api/v1/mfa/totp/setup' },
  { svc: 'OAuth', port: 11006, desc: 'OAuth 2.1、OIDC、DPoP、令牌交换、设备码', path: '/oauth/token' },
  { svc: 'Tenant', port: 11003, desc: '多租户 CRUD、部门、品牌定制、邀请', path: '/api/v1/tenants' },
  { svc: 'RBAC', port: 11025, desc: '角色、权限、SoD、审批流', path: '/api/v1/admin/roles' },
  { svc: 'Audit', port: 11013, desc: 'Merkle 哈希链审计、异常检测、SIEM', path: '/api/v1/internal/audit-logs' },
  { svc: 'Session', port: 11004, desc: '会话 CRUD、令牌黑名单、设备信任、分析', path: '/api/v1/sessions' },
  { svc: 'Profile', port: 11002, desc: '用户资料、隐私、标签、同意管理、数据导出', path: '/api/v1/profiles' },
];
const faqs = [
  { q: '使用了哪些端口？', a: '服务运行在 11001–11025（HTTP）与 12001–12025（gRPC）端口。网关端口为 11080，PostgreSQL 为 15432，Redis 为 16379。完整端口对照表见文档。' },
  { q: '默认凭据是什么？', a: '示例账号（仅限本地演示，请勿用于生产）：admin@admin.com / admin123。生产环境请务必修改密码，并配置 JWT_SECRET、PASSWORD_PEPPER 等密钥。' },
  { q: '如何启用 HTTPS？', a: '参见 docker/nginx/certs/ 中的 100 年有效期自签名证书。生产环境请使用 Let\'s Encrypt 或你自己的 CA。SSL 终止由 nginx 网关处理。' },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Layout
  title="文档 — Autional"
  description="Autional 身份平台的快速开始指南与 API 参考。"
  keywords="Autional, 文档, docs, 快速开始, API 参考, 身份, IAM"
  jsonLd={[faqJsonLd]}
>
  <section class="mx-auto max-w-5xl px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold sm:text-5xl">5 分钟快速开始</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">运行 27 个微服务、为你的应用接入认证，或部署到生产环境。开源发布，基于 AGPL-3.0。</p>
    </div>

    <!-- Steps -->
    <div class="space-y-8 mb-20">{steps.map(s => (
      <div class="grid gap-6 lg:grid-cols-2 items-start rounded-md border border-neutral-200 dark:border-neutral-800 p-6">
        <div><div class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary-600 text-white text-sm font-bold">{s.icon}</div><h3 class="mt-3 text-xl font-bold">{s.title}</h3></div>
        <div class="rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 overflow-x-auto"><pre class="text-sm text-syntax-plain font-mono leading-relaxed">{s.code}</pre></div>
    </div>
    ))}
    </div>
    <p class="mt-8 text-center"><a href="https://docs.autional.cn" class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 hover:text-primary-700">访问完整文档门户 →</a></p>

    <!-- API Reference -->
    <h2 class="text-2xl font-bold mb-8">API 参考</h2>
    <p class="text-neutral-500 mb-6">全部 27 个微服务都提供交互式 Swagger/OpenAPI 文档。以下是关键服务及其基础路径：</p>
    <div class="grid gap-4 sm:grid-cols-2">{apis.map(a => (
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-4"><div class="flex items-center gap-2"><span class="rounded-xs bg-primary-50 text-primary-700 px-2 py-0.5 text-xs font-mono font-medium">{a.svc}</span><span class="text-xs text-neutral-500">:{a.port}</span></div><p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{a.desc}</p><code class="mt-2 block text-xs text-neutral-400 font-mono">{a.path}</code></div>
    ))}</div>
    <div class="mt-6 text-center"><p class="text-sm text-neutral-500">完整 OpenAPI 规范：<a href="https://reference.autional.cn" class="text-primary-600 hover:underline">reference.autional.cn</a></p></div>

    <!-- FAQ -->
    <div class="mt-20"><h2 class="text-2xl font-bold text-center mb-8">常见问题</h2>
      <div class="space-y-4 max-w-3xl mx-auto">{faqs.map(f => (
        <details class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 group"><summary class="font-medium cursor-pointer list-none flex justify-between items-center">{f.q}<span class="text-neutral-400 group-open:rotate-45 transition-transform text-lg">+</span></summary><p class="mt-3 text-sm text-neutral-500 leading-relaxed">{f.a}</p></details>
      ))}</div>
    </div>
  </section>
</Layout>
