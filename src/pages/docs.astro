---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { brotherUrl } from '../lib/site-env';

interface DocStep { title: string; code: string }
interface DocFaq { q: string; a: string }

const steps = t('docs.steps', { returnObjects: true }) as DocStep[];
const apiDescs = t('docs.apiDescs', { returnObjects: true }) as string[];
const faqs = t('docs.faqs', { returnObjects: true }) as DocFaq[];
// 区域派生链接（W7/W11）：快速开始指南 / 文档门户 / API 参考（兄弟站随本区根域派生）
const quickstartUrl = `${brotherUrl('developer')}/quickstart`;
const docsPortalUrl = brotherUrl('docs');
const referenceUrl = brotherUrl('reference');
const referenceHost = new URL(referenceUrl).host;
const issuerUrl = brotherUrl('api');
// 步骤代码区域 URL 占位符替换
const fillCode = (code: string) => code.replaceAll('{{quickstartUrl}}', quickstartUrl).replaceAll('{{issuer}}', issuerUrl);
// 语言中立结构（与 docs.steps 顺序一一对应）
const stepMeta = [{ icon: '1', lang: 'bash' }, { icon: '2', lang: 'bash' }, { icon: '3', lang: 'tsx' }, { icon: '4', lang: 'bash' }];
// API 卡片结构（语言中立；desc 取 docs.apiDescs 同序）
const apis = [
  { svc: 'Identity', port: 11001, path: '/api/v1/auth/login' },
  { svc: 'MFA', port: 11005, path: '/api/v1/mfa/totp/setup' },
  { svc: 'OAuth', port: 11006, path: '/oauth/token' },
  { svc: 'Tenant', port: 11003, path: '/api/v1/tenants' },
  { svc: 'RBAC', port: 11025, path: '/api/v1/admin/roles' },
  { svc: 'Audit', port: 11013, path: '/api/v1/internal/audit-logs' },
  { svc: 'Session', port: 11004, path: '/api/v1/sessions' },
  { svc: 'Profile', port: 11002, path: '/api/v1/profiles' },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Layout
  title={t('docs.meta.title')}
  description={t('docs.meta.description')}
  keywords={t('docs.meta.keywords')}
  jsonLd={[faqJsonLd]}
>
  <section class="mx-auto max-w-5xl px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold sm:text-5xl">{t('docs.title')}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">{t('docs.lead')}</p>
    </div>

    <!-- Steps -->
    <div class="space-y-8 mb-20">{steps.map((s, i) => (
      <div class="grid gap-6 lg:grid-cols-2 items-start rounded-md border border-neutral-200 dark:border-neutral-800 p-6">
        <div><div class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary-600 text-white text-sm font-bold">{stepMeta[i].icon}</div><h3 class="mt-3 text-xl font-bold">{s.title}</h3></div>
        <div class="rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-4 overflow-x-auto"><pre class="text-sm text-syntax-plain font-mono leading-relaxed">{fillCode(s.code)}</pre></div>
    </div>
    ))}
    </div>
    <p class="mt-8 text-center"><a href={docsPortalUrl} class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 hover:text-primary-700">{t('docs.portalLink')} →</a></p>

    <!-- API Reference -->
    <h2 class="text-2xl font-bold mb-8">{t('docs.apiTitle')}</h2>
    <p class="text-neutral-500 mb-6">{t('docs.apiLead')}</p>
    <div class="grid gap-4 sm:grid-cols-2">{apis.map((a, i) => (
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-4"><div class="flex items-center gap-2"><span class="rounded-xs bg-primary-50 text-primary-700 px-2 py-0.5 text-xs font-mono font-medium">{a.svc}</span><span class="text-xs text-neutral-500">:{a.port}</span></div><p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{apiDescs[i]}</p><code class="mt-2 block text-xs text-neutral-400 font-mono">{a.path}</code></div>
    ))}</div>
    <div class="mt-6 text-center"><p class="text-sm text-neutral-500">{t('docs.apiSpecPrefix')} <a href={referenceUrl} class="text-primary-600 hover:underline">{referenceHost}</a></p></div>

    <!-- FAQ -->
    <div class="mt-20"><h2 class="text-2xl font-bold text-center mb-8">{t('docs.faqTitle')}</h2>
      <div class="space-y-4 max-w-3xl mx-auto">{faqs.map(f => (
        <details class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 group"><summary class="font-medium cursor-pointer list-none flex justify-between items-center">{f.q}<span class="text-neutral-400 group-open:rotate-45 transition-transform text-lg">+</span></summary><p class="mt-3 text-sm text-neutral-500 leading-relaxed">{f.a}</p></details>
      ))}</div>
    </div>
  </section>
</Layout>
