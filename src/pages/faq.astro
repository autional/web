---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';

interface FaqItem { q: string; a: string }

const faqItems = t('faq.items', { returnObjects: true }) as FaqItem[];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Layout
  title={t('faq.meta.title')}
  description={t('faq.meta.description')}
  keywords={t('faq.meta.keywords')}
  jsonLd={[faqJsonLd]}
>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-4xl font-bold sm:text-5xl text-center">{t('faq.title')}</h1>
    <div class="mt-12 space-y-4">
      {faqItems.map(({q,a}) => (
        <details class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 group">
          <summary class="font-medium cursor-pointer list-none flex justify-between items-center">{q}<span class="text-neutral-400 group-open:rotate-45 transition-transform text-lg">+</span></summary>
          <p class="mt-3 text-sm text-neutral-500 leading-relaxed">{a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
