---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { GITHUB_ORG_URL } from '../lib/site-env';

interface ContactCard { title: string; desc: string; cta: string }

const cards = t('contact.cards', { returnObjects: true }) as ContactCard[];
// 卡片链接（语言中立；GitHub 链接依 W6 裁定统一 github.com/autional）
const cardHrefs = [`${GITHUB_ORG_URL}/web/issues`, 'mailto:support@autional.net', '/docs'];
---
<Layout title={t('contact.meta.title')} description={t('contact.meta.description')} keywords={t('contact.meta.keywords')}>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold sm:text-5xl">{t('contact.title')}</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-neutral-500">{t('contact.lead')}</p>
    <div class="mt-12 grid gap-8 sm:grid-cols-3 text-left">
      {cards.map((c, i) => (
        <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-6"><h3 class="font-semibold">{c.title}</h3><p class="mt-2 text-sm text-neutral-500">{c.desc}</p><a href={cardHrefs[i]} class="mt-3 inline-block text-sm text-primary-600 hover:underline">{c.cta}</a></div>
      ))}
    </div>
  </section>
</Layout>
