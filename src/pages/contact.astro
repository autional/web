---
import Layout from '../layouts/LandingLayout.astro';
---
<Layout title="联系我们 — Autional" description="与 Autional 团队取得联系。" keywords="Autional, 联系, 销售, 支持, 企业, 身份">
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold sm:text-5xl">联系我们</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-neutral-500">技术问题、商务咨询或合作机会 —— 欢迎与我们联系。</p>
    <div class="mt-12 grid gap-8 sm:grid-cols-3 text-left">
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-6"><h3 class="font-semibold">技术支持</h3><p class="mt-2 text-sm text-neutral-500">GitHub Issues</p><a href="https://github.com/autional-cn/web/issues" class="mt-3 inline-block text-sm text-primary-600 hover:underline">提交 Issue →</a></div>
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-6"><h3 class="font-semibold">商务咨询</h3><p class="mt-2 text-sm text-neutral-500">企业授权、合作伙伴</p><a href="mailto:support@autional.net" class="mt-3 inline-block text-sm text-primary-600 hover:underline">support@autional.net</a></div>
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-6"><h3 class="font-semibold">文档</h3><p class="mt-2 text-sm text-neutral-500">API 文档、部署指南</p><a href="/docs" class="mt-3 inline-block text-sm text-primary-600 hover:underline">查看文档 →</a></div>
    </div>
  </section>
</Layout>
