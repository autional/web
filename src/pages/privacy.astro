---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';

interface PrivacyItem { label: string; value: string }

const s1Items = t('privacy.s1.items', { returnObjects: true }) as PrivacyItem[];
const s2Items = t('privacy.s2.items', { returnObjects: true }) as string[];
const contactEmail = t('privacy.contactEmail');
// 政策修订日期（语言中立事实；标签按语言渲染）
const updated = '2026-10-05';
---
<Layout title={t('privacy.meta.title')} description={t('privacy.meta.description')} keywords={t('privacy.meta.keywords')}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-4xl font-bold sm:text-5xl">{t('privacy.title')}</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">{t('privacy.updatedLabel', { date: updated })}</p>
    <div class="mt-8 prose prose-lg dark:prose-invert max-w-none">
      <p>{t('privacy.intro')}</p>
      <h2>{t('privacy.s1.title')}</h2>
      <ul>{s1Items.map(i => <li><strong>{i.label}</strong> {i.value}</li>)}</ul>
      <h2>{t('privacy.s2.title')}</h2>
      <ul>{s2Items.map(i => <li>{i}</li>)}</ul>
      <h2>{t('privacy.s3.title')}</h2>
      <p>{t('privacy.s3.body')}</p>
      <h2>{t('privacy.s4.title')}</h2>
      <p>{t('privacy.s4.body', { email: contactEmail })}</p>
      <h2>{t('privacy.s5.title')}</h2>
      <p>{t('privacy.s5.label')} <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </div>
  </section>
</Layout>
