---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { FUTURE_ROADMAP, type RoadmapPhase } from '../lib/product-roadmap';

const completed = t('roadmap.completed', { returnObjects: true }) as RoadmapPhase;
// 未来阶段（W10 键化）：lib 只留键序，period/items 文案均在 i18n roadmap.future.*
const futurePhases = FUTURE_ROADMAP.map((key) => t(key, { returnObjects: true }) as RoadmapPhase);
const phases = [
  { period: completed.period, color: 'green', items: completed.items },
  ...futurePhases.map((p, i) => ({ period: p.period, color: i >= 2 ? 'gray' : 'blue', items: p.items })),
];
---
<Layout title={t('roadmap.meta.title')} description={t('roadmap.meta.description')} keywords={t('roadmap.meta.keywords')}>
  <section class="mx-auto max-w-4xl px-4 py-20">
    <h1 class="text-4xl font-bold sm:text-5xl text-center">{t('roadmap.title')}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-neutral-500">{t('roadmap.lead')}</p>
    <div class="mt-16 space-y-8">{phases.map(p => (
      <div class={`rounded-md border p-6 ${p.color === 'green' ? 'border-success-soft bg-success-soft dark:border-success-soft dark:bg-success-soft/10' : 'border-neutral-200 dark:border-neutral-800'}`}>
        <div class={`text-sm font-semibold mb-3 ${p.color === 'green' ? 'text-success-text' : 'text-primary-600'}`}>{p.period}</div>
        <ul class="grid gap-2 sm:grid-cols-2">{p.items.map(i => <li class="flex items-start gap-2 text-sm"><span class={`mt-0.5 shrink-0 ${p.color === 'green' ? 'text-success-text' : 'text-primary-500'}`}>{p.color === 'green' ? '✓' : '→'}</span>{i}</li>)}</ul>
      </div>
    ))}</div>
  </section>
</Layout>
