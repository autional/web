---
import Layout from '../layouts/LandingLayout.astro';
import { FUTURE_ROADMAP } from '../lib/product-roadmap';
const phases = [
  { period: '已完成', color: 'green', items: ['多租户架构，按租户隔离', 'SAML 2.0 + OIDC + OAuth 2.1 企业级 SSO', 'MFA：TOTP、短信、邮件、WebAuthn/FIDO2/Passkey', '自适应 MFA —— 基于风险的 7 类信号认证', 'NHI（非人类身份）—— 智能体/机器人/设备生命周期', 'RBAC + ABAC + ReBAC + PIM 授权模型', 'Merkle 哈希链审计，支持 GDPR DSAR 自动化', '15 个合规框架（GDPR/SOX/PCI/HIPAA/ISO/等保）', '国密算法：SM2/SM3/SM4、Ed25519', '27 个微服务共 1,400+ 个 REST API 端点', 'npm SDK 与设计系统软件包已发布（@autional/react、@autional/ui 等）', 'Webhook 事件系统，支持 600+ 种事件类型', '用于内部通信的 gRPC 服务网格', '密码传输加密（ECDH/RSA/哈希/明文）', '字段级 AES-256-GCM 加密，支持密钥轮换', '身份 API 支持 IPv6 双栈'] },
  ...FUTURE_ROADMAP.map((p, i) => ({ ...p, color: i >= 2 ? 'gray' : 'blue' })),
];
---
<Layout title="路线图 — Autional" description="Autional 产品路线图与研发优先级。" keywords="Autional, 路线图, 规划, 2026, 2027, SDK, 云, 通行密钥, 企业, SOC 2">
  <section class="mx-auto max-w-4xl px-4 py-20">
    <h1 class="text-4xl font-bold sm:text-5xl text-center">路线图</h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-neutral-500">我们已经构建的、正在构建的，以及前进的方向。所有日期均为预估，可能调整。</p>
    <div class="mt-16 space-y-8">{phases.map(p => (
      <div class={`rounded-md border p-6 ${p.color === 'green' ? 'border-green-200 bg-green-50 dark:border-green-900 dark:bg-green-900/10' : 'border-neutral-200 dark:border-neutral-800'}`}>
        <div class={`text-sm font-semibold mb-3 ${p.color === 'green' ? 'text-green-700 dark:text-green-400' : 'text-primary-600'}`}>{p.period}</div>
        <ul class="grid gap-2 sm:grid-cols-2">{p.items.map(i => <li class="flex items-start gap-2 text-sm"><span class={`mt-0.5 shrink-0 ${p.color === 'green' ? 'text-green-500' : 'text-primary-500'}`}>{p.color === 'green' ? '✓' : '→'}</span>{i}</li>)}</ul>
      </div>
    ))}</div>
  </section>
</Layout>
