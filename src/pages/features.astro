---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';

interface FeatureSection {
  title: string;
  desc: string;
  items: string[];
}
const sections = t('features.sections', { returnObjects: true }) as FeatureSection[];
// 章节图标（语言中立装饰；与 i18n features.sections 顺序一一对应）
const icons = ['🔐', '🛡️', '🏢', '👥', '🔑', '🤖', '📊', '🇨🇳', '⚡', '🏗️'];
---
<Layout title={t('features.meta.title')} description={t('features.meta.description')} keywords={t('features.meta.keywords')}>
  <section class="mx-auto max-w-7xl px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl text-balance">{t('features.hero.titleLine1')}<br/>{t('features.hero.titleLine2')}</h1>
      <p class="mx-auto mt-4 max-w-3xl text-lg text-neutral-500">{t('features.hero.lead')}</p>
    </div>
    <div class="space-y-10">
      {sections.map((s, i) => (
        <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 p-8 sm:p-10">
          <div class="text-4xl mb-4">{icons[i]}</div>
          <h2 class="text-2xl font-bold mb-3">{s.title}</h2>
          <p class="text-neutral-500 leading-relaxed mb-4 max-w-3xl">{s.desc}</p>
          <ul class="grid gap-2 sm:grid-cols-2">
            {s.items.map(item => <li class="flex items-start gap-2 text-sm"><span class="text-primary-500 mt-0.5 shrink-0">✓</span><span>{item}</span></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
