---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';

const s3Items = t('terms.s3.items', { returnObjects: true }) as string[];
const contactEmail = t('terms.contactEmail');
// 条款修订日期（语言中立事实；标签按语言渲染）
const updated = '2026-10-05';
---
<Layout title={t('terms.meta.title')} description={t('terms.meta.description')} keywords={t('terms.meta.keywords')}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-4xl font-bold sm:text-5xl">{t('terms.title')}</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">{t('terms.updatedLabel', { date: updated })}</p>
    <div class="mt-8 prose prose-lg dark:prose-invert max-w-none">
      <h2>{t('terms.s1.title')}</h2>
      <p>{t('terms.s1.body')}</p>
      <h2>{t('terms.s2.title')}</h2>
      <p>{t('terms.s2.body')}</p>
      <h2>{t('terms.s3.title')}</h2>
      <ul>{s3Items.map(i => <li>{i}</li>)}</ul>
      <h2>{t('terms.s4.title')}</h2>
      <p>{t('terms.s4.body')}</p>
      <h2>{t('terms.s5.title')}</h2>
      <p>{t('terms.s5.label')} <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </div>
  </section>
</Layout>
