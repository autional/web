---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { brotherUrl, GITHUB_ORG_URL } from '../lib/site-env';
import { SITE_FACTS } from '../lib/site-facts';

interface PkgMeta { name: string; desc: string; install: string }

// 已发布软件包以 npm 实查为准（单一来源：src/lib/site-facts.ts）；desc/install 取 i18n（sdk.packages 按包名对齐）
const pkgMeta = Object.fromEntries(
  (t('sdk.packages', { returnObjects: true }) as PkgMeta[]).map((p) => [p.name, p]),
);
const published = SITE_FACTS.publishedPackages.map((p) => ({
  ...p,
  ...(pkgMeta[p.name] ?? { desc: '', install: `npm install ${p.name}` }),
}));
const issuerUrl = brotherUrl('api');
const quickstart = {
  lang: 'React',
  code: t('sdk.quickstartCode').replaceAll('{{issuer}}', issuerUrl),
  install: t('sdk.quickstartInstall'),
};
const quickstartUrl = `${brotherUrl('developer')}/quickstart`;
---
<Layout title={t('sdk.meta.title')} description={t('sdk.meta.description')} keywords={t('sdk.meta.keywords')}>
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold sm:text-5xl">{t('sdk.title')}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">{t('sdk.lead')}</p>
    </div>

    <!-- Quickstart -->
    <div class="mb-20"><h2 class="text-2xl font-bold mb-8 text-center">{t('sdk.quickstartTitle')}</h2>
      <div class="mx-auto max-w-3xl">
        <div class="flex items-center gap-3 mb-2"><span class="rounded-full bg-primary-50 text-primary-700 px-3 py-0.5 text-xs font-medium">{quickstart.lang}</span></div>
        <div class="rounded-xl bg-slate-900 dark:bg-slate-950 border border-neutral-700 p-5 overflow-x-auto">
          <pre class="text-sm text-syntax-plain font-mono leading-relaxed">{quickstart.code}</pre>
          <p class="mt-3 text-xs text-neutral-500 font-mono border-t border-neutral-700 pt-3"><span class="text-syntax-comment">$</span> {quickstart.install}</p>
        </div>
      </div>
    </div>

    <!-- Published Packages -->
    <h2 class="text-2xl font-bold mb-8">{t('sdk.publishedTitle')}</h2>
    <div class="grid gap-3 sm:grid-cols-2">{published.map(p => (
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-4 flex flex-col justify-between">
        <div><code class="text-sm font-mono font-semibold text-primary-700 dark:text-primary-300">{p.name}</code><span class="ml-2 rounded-xs bg-neutral-100 dark:bg-slate-800 px-2 py-0.5 text-xs font-mono text-neutral-500">{p.version}</span><p class="mt-1 text-sm text-neutral-500">{p.desc}</p></div>
        <div class="mt-3 text-xs"><code class="text-neutral-400 bg-neutral-50 dark:bg-slate-900 px-2 py-1 rounded-xs">{p.install}</code></div>
      </div>
    ))}</div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <div class="brand-card inline-block px-10 py-8">
        <p class="text-lg font-semibold text-primary-900 dark:text-white">{t('sdk.readyTitle')}</p>
        <p class="mt-2 text-sm text-neutral-500">{t('sdk.readyLead')}</p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
          <a href={quickstartUrl} class="brand-button-primary">{t('sdk.quickstartCta')} →</a>
          <a href={GITHUB_ORG_URL} class="rounded-full border border-neutral-300 dark:border-neutral-700 px-5 py-2.5 text-sm font-semibold text-neutral-700 dark:text-neutral-200 transition hover:bg-neutral-50 dark:hover:bg-white/10">{t('sdk.githubCta')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
