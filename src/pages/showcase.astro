---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { brotherUrl } from '../lib/site-env';

interface ShowcaseStat { value: string; label: string }
interface ShowcaseEntry { title: string; desc: string; label: string }

const stats = t('showcase.stats', { returnObjects: true }) as ShowcaseStat[];
const entries = t('showcase.entries', { returnObjects: true }) as ShowcaseEntry[];
// 条目 href：兄弟站随本区根域派生（W7）；站内链接保持相对路径
const entryHrefs = [brotherUrl('demo'), brotherUrl('docs'), `${brotherUrl('developer')}/quickstart`, brotherUrl('reference'), '/features', '/sdk'];
---
<Layout title={t('showcase.meta.title')} description={t('showcase.meta.description')} keywords={t('showcase.meta.keywords')}>
  <section class="mx-auto max-w-5xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold sm:text-5xl">{t('showcase.title')}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">{t('showcase.lead')}</p>
    <div class="mt-12 grid grid-cols-2 gap-6 md:grid-cols-4">
      {stats.map(s => (
        <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-slate-900 p-6 shadow-card"><div class="text-3xl font-bold text-primary-600">{s.value}</div><div class="mt-1 text-sm text-neutral-500">{s.label}</div></div>
      ))}
    </div>
    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 text-left">
      {entries.map((e, i) => (
        <div class="flex flex-col rounded-xl border border-neutral-200 dark:border-neutral-800 p-6"><h3 class="font-semibold">{e.title}</h3><p class="mt-2 flex-1 text-sm text-neutral-500">{e.desc}</p><a href={entryHrefs[i]} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary-600 hover:text-primary-700">{e.label} →</a></div>
      ))}
    </div>
  </section>
</Layout>
