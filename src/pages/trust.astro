---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';

interface TrustCard { title: string; desc: string }

const cards = t('trust.cards', { returnObjects: true }) as TrustCard[];
// 卡片图标（语言中立装饰；与 trust.cards 顺序一一对应）
const icons = ['🔐', '🔒', '📝', '🛡️', '🌐', '🔑', '🏗️', '🔍'];
---
<Layout title={t('trust.meta.title')} description={t('trust.meta.description')} keywords={t('trust.meta.keywords')}>
  <section class="mx-auto max-w-4xl px-4 py-20">
    <div class="text-center mb-16"><h1 class="text-4xl font-bold sm:text-5xl">{t('trust.title')}</h1><p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500">{t('trust.lead')}</p></div>
    <div class="grid gap-6 sm:grid-cols-2 mb-16">
      {cards.map((c, i) => (
        <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-6"><div class="text-2xl mb-2">{icons[i]}</div><h3 class="font-semibold mb-1">{c.title}</h3><p class="text-sm text-neutral-500 leading-relaxed">{c.desc}</p></div>
      ))}
    </div>
    <div class="rounded-md bg-neutral-50 dark:bg-surface border border-neutral-200 dark:border-neutral-800 p-8"><h2 class="text-xl font-bold text-center mb-4">{t('trust.disclaimerTitle')}</h2><p class="text-sm text-neutral-500 leading-relaxed">{t('trust.disclaimer')}</p></div>
  </section>
</Layout>
