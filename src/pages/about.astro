---
import LandingLayout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { FUTURE_ROADMAP, type RoadmapPhase } from '../lib/product-roadmap';

interface ValueItem { title: string; desc: string }
interface MilestoneItem { title: string; desc: string }

const values = t('about.values', { returnObjects: true }) as ValueItem[];
const milestones = t('about.milestones', { returnObjects: true }) as MilestoneItem[];
// 路线图未来阶段（W10 键化）：文案取 i18n（roadmap.future.*，en/zh 双资源）
const futurePhases = FUTURE_ROADMAP.map((key) => t(key, { returnObjects: true }) as RoadmapPhase);
// 语言中立结构（与 about.values / about.milestones 顺序一一对应）
const valueIcons = ['🔓', '⚡', '🤝', '🔒'];
const milestoneDates = ['2024 Q1', '2024 Q4', '2025 Q2', '2026 Q1'];
---
<LandingLayout title={t('about.meta.title')} description={t('about.meta.description')} keywords={t('about.meta.keywords')}>
  <section class="mx-auto max-w-4xl px-4 py-20">
    <!-- Hero -->
    <div class="text-center mb-20">
      <h1 class="text-4xl font-bold sm:text-5xl">{t('about.heroTitle')}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-500 leading-relaxed">{t('about.heroLead')}</p>
    </div>
    <!-- Mission -->
    <div class="rounded-md bg-primary-50 dark:bg-primary-900/10 border border-primary-100 dark:border-primary-900/20 p-10 text-center mb-20">
      <h2 class="text-2xl font-bold">{t('about.missionTitle')}</h2>
      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto leading-relaxed">{t('about.missionBody')}</p>
    </div>
    <!-- Values -->
    <div class="mb-20"><h2 class="text-2xl font-bold text-center mb-12">{t('about.valuesTitle')}</h2>
      <div class="grid gap-6 sm:grid-cols-2">{values.map((v, i) => (
        <div class="rounded-md border border-neutral-200 dark:border-neutral-800 p-8"><div class="text-3xl mb-4">{valueIcons[i]}</div><h3 class="font-semibold text-lg">{v.title}</h3><p class="mt-2 text-sm text-neutral-500 leading-relaxed">{v.desc}</p></div>
      ))}</div>
    </div>
    <!-- Milestones -->
    <div class="mb-20"><h2 class="text-2xl font-bold text-center mb-12">{t('about.milestonesTitle')}</h2>
      <div class="space-y-8">{milestones.map((m, i) => (
        <div class="flex gap-6"><div class="flex flex-col items-center"><div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-600 text-white text-sm font-bold">{i+1}</div>{i < milestones.length-1 && <div class="w-px flex-1 bg-neutral-200 dark:bg-neutral-700 mt-2"></div>}</div>
        <div class="pb-8"><div class="text-sm font-semibold text-primary-600">{milestoneDates[i]}</div><h3 class="text-lg font-bold">{m.title}</h3><p class="mt-1 text-sm text-neutral-500">{m.desc}</p></div></div>
      ))}</div>
    </div>
    <!-- Roadmap -->
    <div><h2 class="text-2xl font-bold text-center mb-12">{t('about.roadmapTitle')}</h2>
      <div class="grid gap-6 md:grid-cols-3">{futurePhases.map(r => (
        <div class="rounded-md border border-neutral-200 dark:border-neutral-800 p-6"><div class="text-sm font-semibold text-primary-600 mb-3">{r.period}</div><ul class="space-y-2">{r.items.map(i => <li class="flex items-start gap-2 text-sm text-neutral-600 dark:text-neutral-300"><span class="text-primary-500 mt-0.5 shrink-0">→</span>{i}</li>)}</ul></div>
      ))}</div>
    </div>
  </section>
</LandingLayout>
