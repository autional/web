---
import LandingLayout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';

interface Comparison {
  name: string;
  url: string;
  pros: string[];
  cons: string[];
  verdict: string;
}

const comparisons = t('compare.comparisons', { returnObjects: true }) as Comparison[];
// 结论区链接：href 为语言中立结构；标签取 compare.linkLabels（与 comparisons 顺序一一对应）
const comparisonLinks: [string, string][][] = [
  [['/pricing', 'pricing'], ['/docs', 'docs']],
  [['/features', 'features'], ['/docs', 'docs']],
  [['/features', 'features']],
  [['/docs', 'docs']],
  [['/pricing', 'pricing']],
];
---
<LandingLayout title={t('compare.meta.title')} description={t('compare.meta.description')} keywords={t('compare.meta.keywords')}>
  <section class="mx-auto max-w-4xl px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold sm:text-5xl">{t('compare.title')}</h1>
      <p class="mt-4 text-lg text-neutral-500 max-w-2xl mx-auto">{t('compare.lead')}</p>
    </div>
    {comparisons.map((c, i) => (
      <div id={c.url.replace('#','')} class="mb-16 rounded-md border border-neutral-200 dark:border-neutral-800 p-8">
        <h2 class="text-2xl font-bold mb-4">{c.name}</h2>
        <div class="grid gap-8 md:grid-cols-2 mb-6">
          <div><h3 class="text-sm font-semibold text-green-600 mb-3">{t('compare.advantage')}</h3><ul class="space-y-2">{c.pros.map(p => <li class="flex items-start gap-2 text-sm"><span class="text-green-500 mt-0.5 shrink-0">✓</span>{p}</li>)}</ul></div>
          <div><h3 class="text-sm font-semibold text-neutral-500 mb-3">{t('compare.considerations')}</h3><ul class="space-y-2">{c.cons.map(p => <li class="flex items-start gap-2 text-sm text-neutral-500"><span class="text-neutral-400 mt-0.5 shrink-0">○</span>{p}</li>)}</ul></div>
        </div>
        <div class="rounded-lg bg-neutral-50 dark:bg-slate-900 p-4 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed"><strong class="text-neutral-900 dark:text-white">{t('compare.verdictLabel')}</strong> {c.verdict}<div class="mt-3 flex flex-wrap gap-4">{comparisonLinks[i].map(([href, key]) => <a href={href} class="font-medium text-primary-600 hover:text-primary-700">{t(`compare.linkLabels.${key}`)} →</a>)}</div></div>
      </div>
    ))}
  </section>
</LandingLayout>
