---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/LandingLayout.astro';
import { t } from '../../i18n';
import { isRegionPost, postSlug } from '../../lib/content-lang';

const cases = await getCollection('cases', ({ data }: { data: CollectionEntry<'cases'>['data'] }) => data.status === 'verified');
const sorted = cases
  .filter((entry: CollectionEntry<'cases'>) => isRegionPost(entry.id))
  .sort((a: CollectionEntry<'cases'>, b: CollectionEntry<'cases'>) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<Layout title={`${t('cases.title')} — Autional`} description={t('cases.pageDesc')}>
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold sm:text-5xl" data-i18n="cases.title">{t('cases.title')}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600 dark:text-neutral-300" data-i18n="cases.subtitle">{t('cases.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {sorted.map((entry: CollectionEntry<'cases'>) => (
        <article class="group flex flex-col rounded-xl border border-neutral-200 bg-white p-6 shadow-card transition-all dark:border-neutral-800 dark:bg-surface hover:border-neutral-300">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-primary-50 dark:bg-primary-900/30 px-2.5 py-0.5 text-xs font-medium text-primary-700">{entry.data.platform}</span>
            <span class="rounded-full bg-neutral-100 dark:bg-white/10 px-2.5 py-0.5 text-xs font-medium text-neutral-600 dark:text-neutral-300">{entry.data.framework}</span>
          </div>
          <a href={`/cases/${postSlug(entry.id)}`} class="mt-4"><h2 class="text-xl font-semibold group-hover:text-primary-600">{entry.data.title}</h2></a>
          <p class="mt-2 flex-1 text-sm text-neutral-600 dark:text-[var(--color-text-muted)]">{entry.data.excerpt}</p>
          <div class="mt-4 flex flex-wrap gap-2">{entry.data.tags.map((tag: string) => <span class="text-xs text-[var(--color-text-muted)]">#{tag}</span>)}</div>
          <div class="mt-4 flex items-center justify-between gap-4 border-t border-neutral-100 pt-4 text-xs text-neutral-500 dark:border-neutral-800">
            <div class="flex items-center gap-4"><span>{entry.data.date}</span><span>{entry.data.readTime}</span></div>
            <a href={`/cases/${postSlug(entry.id)}`} class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 hover:text-primary-700"><span data-i18n="cases.readMore">{t('cases.readMore')}</span> <span class="text-lg">&rarr;</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
