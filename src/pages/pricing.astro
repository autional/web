---
import LandingLayout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';

interface PricingPlan {
  name: string;
  price: string;
  period?: string;
  desc: string;
  features: string[];
  cta: string;
}
interface PricingFaq { q: string; a: string }

const plans = t('pricing.plans', { returnObjects: true }) as PricingPlan[];
const faqs = t('pricing.faqs', { returnObjects: true }) as PricingFaq[];
// 高亮档位（语言中立结构；与 pricing.plans 顺序一一对应）
const planHighlights = [false, true, false];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<LandingLayout
  title={t('pricing.meta.title')}
  description={t('pricing.meta.description')}
  keywords={t('pricing.meta.keywords')}
  jsonLd={[faqJsonLd]}
>
  <section class="mx-auto max-w-7xl px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold sm:text-5xl">{t('pricing.title')}</h1>
      <p class="mt-4 text-lg text-neutral-500 max-w-xl mx-auto">{t('pricing.lead')}</p>
    </div>
    <div class="grid gap-8 lg:grid-cols-3 max-w-5xl mx-auto">
      {plans.map((p, i) => (
        <div class={`rounded-md border p-8 flex flex-col ${planHighlights[i] ? 'border-primary-500 ring-2 ring-primary-500 shadow-card' : 'border-neutral-200 dark:border-neutral-800'}`}>
          {planHighlights[i] && <span class="inline-block rounded-full bg-primary-50 text-primary-700 px-3 py-1 text-xs font-medium w-fit mb-4">{t('pricing.popular')}</span>}
          <h3 class="text-xl font-bold">{p.name}</h3>
          <div class="mt-2"><span class="text-4xl font-extrabold">{p.price}</span>{p.period && <span class="text-neutral-500 text-sm">{p.period}</span>}</div>
          <p class="mt-1 text-sm text-neutral-500">{p.desc}</p>
          <ul class="mt-6 space-y-3 text-sm text-neutral-500 flex-1">
            {p.features.map(f => <li class="flex items-center gap-2"><span class="text-primary-500 shrink-0">✓</span>{f}</li>)}
          </ul>
          <a href="/contact" class={`mt-8 block text-center rounded-lg px-6 py-3 text-sm font-semibold transition-colors ${planHighlights[i] ? 'bg-primary-600 text-white hover:bg-primary-700' : 'border border-neutral-300 hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-slate-900'}`}>{p.cta}</a>
        </div>
      ))}
    </div>
    <!-- FAQ -->
    <div class="max-w-3xl mx-auto mt-20">
      <h2 class="text-2xl font-bold text-center mb-8">{t('pricing.faqTitle')}</h2>
      <div class="space-y-4">{faqs.map(f => (
        <details class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 group">
          <summary class="font-medium cursor-pointer list-none flex justify-between items-center">{f.q}<span class="text-neutral-400 group-open:rotate-45 transition-transform text-lg">+</span></summary>
          <p class="mt-3 text-sm text-neutral-500 leading-relaxed">{f.a}</p>
        </details>
      ))}</div>
    </div>
  </section>
</LandingLayout>
