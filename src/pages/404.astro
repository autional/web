---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
---
<Layout title={t('notFound.meta.title')} description={t('notFound.meta.description')}>
  <div class="flex min-h-[50vh] items-center justify-center px-4 py-20"><div class="text-center">
    <p class="text-8xl font-extrabold text-primary-600">404</p>
    <h1 class="mt-4 text-2xl font-bold sm:text-3xl">{t('notFound.title')}</h1>
    <p class="mt-4 text-neutral-500">{t('notFound.body')}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href="/" class="rounded-lg bg-primary-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-primary-700">{t('notFound.goHome')}</a>
      <a href="/blog" class="rounded-lg border px-6 py-2.5 text-sm font-semibold hover:bg-neutral-50 dark:hover:bg-surface">{t('notFound.browseBlog')}</a>
      {/* 2026-11-02：404 是天然的「我该去哪」时刻，指向全站唯一的 HTML sitemap。 */}
      <a href="/portals" class="rounded-lg border px-6 py-2.5 text-sm font-semibold hover:bg-neutral-50 dark:hover:bg-surface">{t('notFound.allPortals')}</a>
    </div>
  </div></div>
</Layout>
