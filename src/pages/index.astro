---
import Layout from '../layouts/LandingLayout.astro';
import { t } from '../i18n';
import { SITE_FACTS } from '../lib/site-facts';
import { GITHUB_ORG_URL, SITE_ROOT_DOMAIN } from '../lib/site-env';

// 代码样例（技术内容，非文案；API 域随本区根域派生，避免跨区字面量）
const codeSample = `<span class="text-syntax-comment">// app.tsx</span>
<span class="text-syntax-keyword">import</span> {
  <span class="text-white">AutionalProvider</span>,
} <span class="text-syntax-keyword">from</span> <span class="text-syntax-string">'@autional/react'</span>;

<span class="text-syntax-keyword">const</span> <span class="text-white">config</span> = {
  <span class="text-syntax-function">appId</span>: <span class="text-syntax-string">'my-app'</span>,
  <span class="text-syntax-function">issuer</span>: <span class="text-syntax-string">'https://api.${SITE_ROOT_DOMAIN}'</span>,
};

<span class="text-syntax-keyword">export function</span> <span class="text-white">App</span>() {
  <span class="text-syntax-keyword">return</span> (
    <span class="text-syntax-tag">&lt;AutionalProvider</span>
      <span class="text-syntax-function">config</span>=<span class="text-white">{config}</span>
    <span class="text-syntax-tag">&gt;</span>
      <span class="text-syntax-tag">&lt;YourProduct /&gt;</span>
    <span class="text-syntax-tag">&lt;/AutionalProvider&gt;</span>
  );
}`;

const overviewStats = [
  { value: `${SITE_FACTS.serviceCount}`, labelKey: 'home.stats.services' },
  { value: '1,400+', labelKey: 'home.stats.endpoints' },
  { value: '99.95%', labelKey: 'home.stats.sla' },
  { value: '<150ms', labelKey: 'home.stats.latency' },
];

const solutionCards = ['auth', 'enterprise', 'observability'];

const capabilityItems = t('home.capabilities.items', { returnObjects: true }) as { title: string; desc: string }[];
---
<Layout title={t('home.meta.title')} description={t('home.meta.description')} keywords={t('home.meta.keywords')}>
  <section class="relative overflow-hidden px-4 pb-12 pt-10 sm:px-6 lg:px-8 lg:pb-16 lg:pt-16">
    <div class="absolute inset-x-0 top-0 -z-10 h-[34rem] bg-brand-radial"></div>
    <div class="absolute left-1/2 top-20 -z-10 hidden h-80 w-80 -translate-x-10 rounded-full bg-amber-300/20 blur-3xl lg:block"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <div class="brand-kicker">
          <span class="h-2 w-2 rounded-full bg-amber-400"></span>
          {t('home.hero.kicker')}
        </div>
        <h1 class="mt-6 max-w-3xl text-5xl font-extrabold leading-[var(--line-height-display-xl)] tracking-tight text-primary-900 dark:text-white sm:text-6xl sm:leading-[var(--line-height-display-xl)] lg:text-7xl lg:leading-[var(--line-height-display-2xl)]">
          {t('home.hero.titleLine1')}
          <span class="mt-2 block text-sky-500">{t('home.hero.titleLine2')}</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-600 dark:text-sky-50/72">
          {t('home.hero.lead')}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/docs" class="brand-button-primary">{t('home.hero.ctaDocs')}</a>
          <a href="/contact" class="brand-button-secondary">{t('home.hero.ctaContact')}</a>
        </div>
      </div>

      <div class="brand-shell brand-grid relative overflow-hidden p-5 sm:p-6">
        <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-r from-primary-700 via-primary-600 to-sky-500"></div>
        <div class="relative mt-16 rounded-xl bg-white p-5 shadow-brand dark:bg-[var(--color-bg-primary)]/90">
          <div class="flex items-center justify-between gap-4 border-b border-primary-100 pb-4 dark:border-white/10">
            <div class="flex items-center gap-3">
              <img src="/logo-mark.svg" alt={t('home.panel.logoAlt')} class="h-11 w-11 rounded-md" />
              <div>
                <div class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">{t('home.panel.eyebrow')}</div>
                <div class="text-xl font-bold text-primary-900 dark:text-white">{t('home.panel.title')}</div>
              </div>
            </div>
            <div class="rounded-full bg-[var(--color-success-soft)] px-3 py-1 text-xs font-semibold text-[var(--color-success-text)]">{t('home.panel.status')}</div>
          </div>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {overviewStats.map((item) => (
              <div class="rounded-lg border border-primary-100 bg-neutral-50/80 p-4 dark:border-white/10 dark:bg-white/5">
                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-500">{t(item.labelKey)}</div>
                <div class="mt-3 text-3xl font-bold text-primary-900 dark:text-white">{item.value}</div>
              </div>
            ))}
          </div>

          <div class="mt-5 grid gap-4 lg:grid-cols-[0.95fr_1.05fr]">
            <div class="rounded-lg border border-primary-100 p-5 dark:border-white/10">
              <div class="text-sm font-semibold text-primary-900 dark:text-white">{t('home.panel.authMix')}</div>
              <div class="mx-auto mt-5 flex h-40 w-40 items-center justify-center rounded-full" style="background: conic-gradient(var(--color-primary-700) 0deg 120deg, var(--color-sky-500) 120deg 220deg, var(--color-amber-500) 220deg 290deg, var(--color-sky-600) 290deg 360deg);">
                <div class="flex h-24 w-24 items-center justify-center rounded-full bg-white text-center text-xs font-semibold text-neutral-600 dark:bg-[var(--color-bg-primary)] dark:text-sky-100/80">
                  {t('home.panel.riskAwareLine1')}
                  <br />
                  {t('home.panel.riskAwareLine2')}
                </div>
              </div>
              <div class="mt-5 flex flex-wrap gap-2 text-xs font-semibold">
                <span class="rounded-full bg-primary-50 px-3 py-1 text-primary-700 dark:bg-white/10 dark:text-sky-100">SSO 33%</span>
                <span class="rounded-full bg-[var(--color-primary-50)] px-3 py-1 text-[var(--color-primary-700)]">Passkey 28%</span>
                <span class="rounded-full bg-[var(--color-warning-soft)] px-3 py-1 text-[var(--color-warning-text)]">OTP 19%</span>
              </div>
            </div>
            <div class="rounded-lg border border-primary-100 p-5 dark:border-white/10">
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-sm font-semibold text-primary-900 dark:text-white">{t('home.panel.volume')}</div>
                  <div class="mt-1 text-xs text-[var(--color-text-muted)] dark:text-sky-100/70">{t('home.panel.volumeHint')}</div>
                </div>
                <div class="rounded-full bg-[var(--color-success-soft)] px-3 py-1 text-xs font-semibold text-[var(--color-success-text)]">+12.5%</div>
              </div>
              <div class="mt-6 flex h-40 items-end gap-3">
                {[42, 60, 56, 78, 72, 95, 88, 110].map((height, idx) => (
                  <div class="flex-1 rounded-t-md bg-gradient-to-t from-primary-700 via-primary-500 to-sky-300 shadow-soft" style={`height: ${height}%`}>
                    <div class={`h-full w-full rounded-t-md ${idx > 5 ? 'bg-white/10' : ''}`}></div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-4">
      {overviewStats.map((item) => (
        <div class="brand-card px-6 py-5">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-500">{t(item.labelKey)}</div>
          <div class="mt-3 text-3xl font-bold text-primary-900 dark:text-white">{item.value}</div>
          <div class="mt-2 h-1.5 rounded-full bg-gradient-to-r from-primary-700 via-sky-400 to-amber-400"></div>
        </div>
      ))}
    </div>
  </section>

  <!-- Built With -->
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl text-center">
      <div class="brand-card inline-block px-10 py-8">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-500 mb-4">{t('home.builtWith.label')}</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {['Go','TypeScript','PostgreSQL','Redis','RabbitMQ','MongoDB','Docker','Prometheus'].map((tech) => (
            <span class="rounded-full border border-primary-100 bg-white/95 px-4 py-2 text-sm font-medium text-primary-700 shadow-soft transition hover:-translate-y-0.5 hover:border-neutral-300">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <div class="brand-kicker">{t('home.capabilities.kicker')}</div>
        <h2 class="mt-6 text-3xl font-bold leading-[var(--line-height-heading-lg)] tracking-tight text-primary-900 dark:text-white sm:text-5xl sm:leading-[var(--line-height-display-xl)]">{t('home.capabilities.title')}</h2>
        <p class="mt-5 text-lg leading-8 text-neutral-600 dark:text-sky-50/72">{t('home.capabilities.lead')}</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {solutionCards.map((key) => (
          <article class="brand-card p-8">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-500">{t(`home.solutions.${key}.eyebrow`)}</div>
            <h3 class="mt-4 text-2xl font-bold text-primary-900 dark:text-white">{t(`home.solutions.${key}.title`)}</h3>
            <p class="mt-4 text-base leading-7 text-neutral-600 dark:text-sky-50/72">{t(`home.solutions.${key}.description`)}</p>
            <div class="mt-8 flex items-center gap-3">
              <span class="h-2.5 w-2.5 rounded-full bg-primary-700"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-sky-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.92fr_1.08fr]">
      <div class="brand-card overflow-hidden">
        <div class="bg-gradient-to-r from-primary-800 via-primary-700 to-sky-500 px-8 py-8 text-white">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-100">{t('home.snapshot.kicker')}</div>
          <h2 class="mt-4 text-3xl font-bold sm:text-4xl">{t('home.snapshot.title')}</h2>
          <p class="mt-4 max-w-lg text-sm leading-7 text-sky-50/82">{t('home.snapshot.lead')}</p>
        </div>
        <div class="bg-primary-900 p-8">
          <pre class="overflow-x-auto rounded-md border border-white/10 bg-code/70 p-5 text-[13px] leading-8 text-syntax-plain sm:text-sm" set:html={codeSample}></pre>
          <div class="mt-5 rounded-md border border-sky-300/15 bg-code px-4 py-3 text-sm font-mono font-medium text-sky-100 break-all sm:break-normal">{t('home.snapshot.npm')}</div>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {capabilityItems.map((item, idx) => (
          <article class="brand-card p-6">
            <div class="flex items-center justify-between">
              <div class="rounded-md bg-primary-50 px-3 py-2 text-sm font-bold text-primary-700 dark:bg-white/10 dark:text-sky-100">0{idx + 1}</div>
              <div class="h-10 w-10 rounded-md bg-gradient-to-br from-primary-700 via-sky-400 to-amber-400 opacity-90"></div>
            </div>
            <h3 class="mt-5 text-xl font-bold text-primary-900 dark:text-white">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-neutral-600 dark:text-sky-50/72">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl rounded-xxl bg-primary-900 px-8 py-12 text-white shadow-brand sm:px-12">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-100">{t('home.cta.kicker')}</div>
          <h2 class="mt-4 text-3xl font-bold sm:text-5xl">{t('home.cta.title')}</h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-sky-50/78">{t('home.cta.lead')}</p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="/docs" class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-primary-700 transition hover:bg-sky-50">{t('home.cta.docs')}</a>
          <a href={GITHUB_ORG_URL} class="inline-flex items-center justify-center rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
