---
import { getCollection } from 'astro:content';
import ClientShell from '../components/ClientShell.tsx';
// CookieConsent 已下架 (2026-09-29)：站点零 cookie、无追踪脚本，文案与事实不符；组件文件保留待将来接入分析时恢复
import { buildSearchIndex } from '../lib/search-index';
import { isRegionPost } from '../lib/blog-lang';
import { t } from '../i18n';
import { LOCALE, brotherUrl, cdnAsset, GITHUB_ORG_URL } from '../lib/site-env';
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  ogType?: string;
  image?: string;
  keywords?: string;
  jsonLd?: Record<string, any>[];
  noIndex?: boolean;
  /** 页面语言（单源：env 派生 LOCALE；显式传入仅保留给特例页） */
  lang?: string;
  /** hreflang 单源：语言变体页传入全量（含自指与 x-default）；缺省自动生成本区自指 + x-default */
  alternates?: { hreflang: string; href: string }[];
}
const {
  title,
  description = t('layout.defaultDescription'),
  ogType = 'website',
  image,
  keywords,
  jsonLd = [],
  noIndex = false,
  lang = LOCALE,
  alternates,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site!;
const ogImage = image || '/og-default.png';
const fullImageUrl = new URL(ogImage, siteUrl).href;

const hreflangLinks = alternates ?? [
  { hreflang: LOCALE, href: canonical.href },
  { hreflang: 'x-default', href: canonical.href },
];

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Autional',
  url: siteUrl.href,
  logo: new URL('/logo-mark.svg', siteUrl).href,
  description: t('layout.orgDescription'),
  sameAs: [
    GITHUB_ORG_URL,
    'https://twitter.com/autional',
    'https://www.linkedin.com/company/autional',
  ],
};

const allJsonLd = [defaultJsonLd, ...jsonLd];

// 站内搜索索引：构建期生成（静态页键 + 本区全量博客文章）——单一来源，见 src/lib/search-index.ts
const blogPosts = await getCollection('blog', ({ data }) => data.status === 'verified');
const searchIndex = buildSearchIndex(blogPosts.filter((post) => isRegionPost(post.id)));

const year = new Date().getFullYear();
const navLinkClass = 'rounded-full px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-sky-50 hover:text-primary-700 dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white';
const footerLinkClass = 'text-sm text-sky-100/72 transition-colors hover:text-white';
---
<!DOCTYPE html><html lang={lang}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    // 主题恢复（TH-01）：首帧前执行，深色偏好/显式选择均不白闪
    (() => {
      try {
        const saved = localStorage.getItem('autional-theme');
        const dark = saved === 'dark' || (saved === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href={cdnAsset('tokens.css')} />
  <title>{title}</title><meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical.href} />
  <link rel="icon" href={cdnAsset('icons/favicon.ico')} sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href={cdnAsset('icons/favicon-32x32.png')}>
  <link rel="icon" type="image/png" sizes="16x16" href={cdnAsset('icons/favicon-16x16.png')}>
  <link rel="icon" type="image/svg+xml" href={cdnAsset('icons/favicon.svg')}>
  <link rel="apple-touch-icon" sizes="180x180" href={cdnAsset('icons/apple-touch-icon.png')}>
  <link rel="manifest" href={cdnAsset('icons/site.webmanifest')} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} /><meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Autional" />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={fullImageUrl} />
  <meta name="twitter:site" content="@autional" />
  <meta name="twitter:creator" content="@autional" />
  {hreflangLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  {noIndex && <meta name="robots" content="noindex, follow" />}
  {allJsonLd.map((item) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={t('layout.rssTitle')} href="/rss.xml" />
</head>
<body class="flex min-h-screen flex-col text-neutral-900 dark:text-white">
  {/* 顶栏高度此前由内层胶囊的 py-3 撑开（约 48px），与其余 13 个门户的 64px 不一致。
       改为令牌高度 + flex 居中；内层胶囊用 h-full 填满**减去 py-2 后的内容盒**（48px），
       于是外框 64px、胶囊仍悬浮——保留本站的营销站观感，同时与外框节奏对齐。 */}
    <header class="sticky top-0 z-50 flex h-[var(--layout-header-height)] items-center px-3 py-2 sm:px-6">
    <div class="relative mx-auto flex max-w-7xl items-center justify-between rounded-full border border-white/70 bg-white/80 h-full px-4 shadow-soft backdrop-blur-xl dark:border-white/10 dark:bg-[var(--color-bg-primary)]/70 sm:px-6">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo-mark.svg" alt={t('layout.logoAlt')} data-i18n-alt="layout.logoAlt" class="h-10 w-10 object-contain drop-shadow-[0_8px_18px_rgba(0,49,83,0.18)]" />
        <div class="hidden sm:block">
          <div class="text-[1.9rem] font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-900 dark:text-white">Autional</div>
        </div>
      </a>
      <nav class="hidden items-center gap-1 md:flex">
        <a href="/features" class={navLinkClass} data-i18n="nav.features">{t('nav.features')}</a>
        <a href="/sdk" class={navLinkClass} data-i18n="nav.sdk">{t('nav.sdk')}</a>
        <a href="/ai" class={navLinkClass} data-i18n="nav.ai">{t('nav.ai')}</a>
        <a href="/pricing" class={navLinkClass} data-i18n="nav.pricing">{t('nav.pricing')}</a>
        <a href="/docs" class={navLinkClass} data-i18n="nav.docs">{t('nav.docs')}</a>
        <a href="/blog" class={navLinkClass} data-i18n="nav.blog">{t('nav.blog')}</a>
        <a href={GITHUB_ORG_URL} class={navLinkClass}>GitHub</a>
      </nav>
      <ClientShell client:load searchIndex={searchIndex} />
    </div>
  </header>
  <main class="flex-1" id="main-content"><slot /></main>
  <footer class="mt-12 px-4 pb-6 sm:px-6">
    <div class="mx-auto max-w-7xl rounded-xxl bg-primary-900 px-6 py-12 text-white shadow-brand sm:px-10">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-5">
        <div class="md:col-span-2">
          <a href="/" class="inline-flex items-center">
            <div class="text-[2rem] font-extrabold tracking-[var(--letter-spacing-display-lg)] text-white">Autional</div>
          </a>
          <p class="mt-5 max-w-sm text-sm leading-7 text-sky-100/82" data-i18n="footer.description">{t('footer.description')}</p>
        </div>
        <div><h3 class="text-sm font-semibold text-white" data-i18n="footer.platform">{t('footer.platform')}</h3><ul class="mt-4 space-y-3">
          <li><a href="/features" class={footerLinkClass} data-i18n="footer.features">{t('footer.features')}</a></li>
          <li><a href="/pricing" class={footerLinkClass} data-i18n="footer.pricing">{t('footer.pricing')}</a></li>
          <li><a href="/compare" class={footerLinkClass} data-i18n="footer.compare">{t('footer.compare')}</a></li>
          <li><a href="/roadmap" class={footerLinkClass} data-i18n="footer.roadmap">{t('footer.roadmap')}</a></li>
          <li><a href="/showcase" class={footerLinkClass} data-i18n="footer.showcase">{t('footer.showcase')}</a></li>
        </ul></div>
        <div><h3 class="text-sm font-semibold text-white" data-i18n="footer.developers">{t('footer.developers')}</h3><ul class="mt-4 space-y-3">
          <li><a href="/docs" class={footerLinkClass} data-i18n="footer.docs">{t('footer.docs')}</a></li>
          <li><a href="/sdk" class={footerLinkClass} data-i18n="footer.sdk">{t('footer.sdk')}</a></li>
          <li><a href="/ai" class={footerLinkClass} data-i18n="footer.ai">{t('footer.ai')}</a></li>
          <li><a href={brotherUrl('docs')} class={footerLinkClass} data-i18n="footer.docsPortal">{t('footer.docsPortal')}</a></li>
          <li><a href={brotherUrl('developer')} class={footerLinkClass} data-i18n="footer.devPortal">{t('footer.devPortal')}</a></li>
          <li><a href={brotherUrl('reference')} class={footerLinkClass} data-i18n="footer.apiReference">{t('footer.apiReference')}</a></li>
          <li><a href={brotherUrl('wiki')} class={footerLinkClass} data-i18n="footer.apiWiki">{t('footer.apiWiki')}</a></li>
        </ul></div>
        <div><h3 class="text-sm font-semibold text-white" data-i18n="footer.company">{t('footer.company')}</h3><ul class="mt-4 space-y-3">
          <li><a href="/about" class={footerLinkClass} data-i18n="footer.about">{t('footer.about')}</a></li>
          <li><a href="/blog" class={footerLinkClass} data-i18n="footer.blog">{t('footer.blog')}</a></li>
          <li><a href="/faq" class={footerLinkClass} data-i18n="footer.faq">{t('footer.faq')}</a></li>
          <li><a href="/changelog" class={footerLinkClass} data-i18n="footer.changelog">{t('footer.changelog')}</a></li>
          <li><a href="/contact" class={footerLinkClass} data-i18n="footer.contact">{t('footer.contact')}</a></li>
        </ul></div>
      </div>
      <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-sky-100/68 sm:flex-row sm:items-center sm:justify-between">
        <p data-i18n="footer.copyright">{t('footer.copyright', { year })}</p>
        <div class="flex flex-wrap gap-4">
          <a href="/privacy" class="transition-colors hover:text-white" data-i18n="footer.privacy">{t('footer.privacy')}</a>
          <a href="/terms" class="transition-colors hover:text-white" data-i18n="footer.terms">{t('footer.terms')}</a>
          <a href="/trust" class="transition-colors hover:text-white" data-i18n="footer.trust">{t('footer.trust')}</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // chrome 语言交换（B1-5，单源机制）：LangSwitch 调 setLang() 后广播 LANG_EVENT，
    // 本脚本把带 data-i18n / data-i18n-<attr> 的静态 chrome 节点就地重写为当前语言；
    // 页面正文与博客/列表内容保持区域默认语言（不与切换联动）——文案键来自同一份 i18n 资源。
    import { LANG_EVENT, i18nReady, restoreLang, t } from '../i18n';

    const ATTRS = ['aria-label', 'alt', 'title', 'placeholder'] as const;

    const applyChrome = () => {
      const params = { year: new Date().getFullYear() };
      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const key = el.dataset.i18n;
        if (key) el.textContent = t(key, params);
      });
      for (const attr of ATTRS) {
        document.querySelectorAll<HTMLElement>(`[data-i18n-${attr}]`).forEach((el) => {
          const key = el.getAttribute(`data-i18n-${attr}`);
          if (key) el.setAttribute(attr, t(key, params));
        });
      }
    };

    window.addEventListener(LANG_EVENT, applyChrome);
    // 采纳已存偏好（若有）后统一重写一次；restoreLang 内部走 setLang → 事件，此处兜底无偏好路径
    i18nReady.then(() => {
      restoreLang();
      applyChrome();
    });
  </script>
</body></html>
