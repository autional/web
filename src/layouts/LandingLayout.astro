---
import { getCollection } from 'astro:content';
import ClientShell from '../components/ClientShell.tsx';
// CookieConsent 已下架 (2026-09-29)：站点零 cookie、无追踪脚本，文案与事实不符；组件文件保留待将来接入分析时恢复
import { buildSearchIndex } from '../lib/search-index';
import { isRegionPost } from '../lib/content-lang';
import { t } from '../i18n';
import { LOCALE, brotherUrl, GITHUB_ORG_URL, OTHER_REGION_SITE_URL } from '../lib/site-env';
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  ogType?: string;
  image?: string;
  keywords?: string;
  jsonLd?: Record<string, any>[];
  noIndex?: boolean;
  /** 页面语言（单源：env 派生 LOCALE；显式传入仅保留给特例页） */
  lang?: string;
  /** hreflang 单源：语言变体页传入全量（含自指与 x-default）；缺省自动生成本区自指 + x-default */
  alternates?: { hreflang: string; href: string }[];
}
const {
  title,
  description = t('layout.defaultDescription'),
  ogType = 'website',
  image,
  keywords,
  jsonLd = [],
  noIndex = false,
  lang = LOCALE,
  alternates,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site!;
const ogImage = image || '/og-default.png';
const fullImageUrl = new URL(ogImage, siteUrl).href;

// 跨区语言对（B1 单源双区）：两区路由集合逐条对齐（sitemap 实测 75/75 一致），
// 故同路径在对侧必存在。x-default 固定指 .com（英文区），两区输出一致——
// 原实现两区各指自己，等于给出冲突信号。显式传入 alternates 的特例页不受影响。
const otherRegionCanonical = new URL(Astro.url.pathname, OTHER_REGION_SITE_URL).href;
const enCanonical = LOCALE === 'en-US' ? canonical.href : otherRegionCanonical;
const zhCanonical = LOCALE === 'zh-CN' ? canonical.href : otherRegionCanonical;
const hreflangLinks = alternates ?? [
  { hreflang: 'en-US', href: enCanonical },
  { hreflang: 'zh-CN', href: zhCanonical },
  { hreflang: 'x-default', href: enCanonical },
];

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Autional',
  url: siteUrl.href,
  logo: new URL('/logo-mark.svg', siteUrl).href,
  description: t('layout.orgDescription'),
  sameAs: [
    GITHUB_ORG_URL,
    'https://twitter.com/autional',
    'https://www.linkedin.com/company/autional',
  ],
};

const allJsonLd = [defaultJsonLd, ...jsonLd];

// 站内搜索索引：构建期生成（静态页键 + 本区全量博客文章 + 本区案例）——单一来源，见 src/lib/search-index.ts
const blogPosts = await getCollection('blog', ({ data }) => data.status === 'verified');
const cases = await getCollection('cases', ({ data }) => data.status === 'verified');
const searchIndex = buildSearchIndex(
  blogPosts.filter((post) => isRegionPost(post.id)),
  cases.filter((entry) => isRegionPost(entry.id)),
);

const year = new Date().getFullYear();
// px-3（12px，2026-11-02 从 px-3.5 回收）：1280 边界英文区实测余量为 0，
// 新增「登录」入口必须先从这里腾宽度。回归手段：`node .tmp/pw/measure2.mjs`（见方案 W1）。
const navLinkClass = 'rounded-full px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-sky-50 hover:text-primary-700 dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white';
const footerLinkClass = 'text-sm text-sky-100/72 transition-colors hover:text-white';

// 导航高亮单源（2026-10-08）：aria-current 由 SSR 按当前路径算，桌面静态导航与移动 island 共用同一判据
const currentPath = Astro.url.pathname;
const isCurrentPath = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
// 头部 CTA 落点：与本区 docs/sdk 页的「快速开始」同源（developer 门户 quickstart），不另造入口
const quickstartUrl = `${brotherUrl('developer')}/quickstart`;
const signInUrl = `${brotherUrl('auth')}/`;
---
<!DOCTYPE html><html lang={lang}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    // 主题恢复（TH-01）：首帧前执行，深色偏好/显式选择均不白闪
    (() => {
      try {
        const saved = localStorage.getItem('autional-theme');
        const dark = saved === 'dark' || (saved === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
  <title>{title}</title><meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical.href} />
  <!-- icons:start（由 ui/scripts/sync-consumers.mjs 生成，勿手改） -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- icons:end -->
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} /><meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Autional" />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={fullImageUrl} />
  <meta name="twitter:site" content="@autional" />
  <meta name="twitter:creator" content="@autional" />
  {hreflangLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  {noIndex && <meta name="robots" content="noindex, follow" />}
  {allJsonLd.map((item) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={t('layout.rssTitle')} href="/rss.xml" />
</head>
<body class="flex min-h-screen flex-col">
  {/* 跳至主内容（2026-10-08）：键盘用户第一个 Tab 即达；sr-only 隐藏，聚焦时以品牌胶囊形态浮出 */}
  <a
    href="#main-content"
    class="sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:h-auto focus:w-auto focus:m-0 focus:overflow-visible focus:whitespace-normal focus:[clip:auto] focus:rounded-full focus:bg-primary-700 focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white focus:shadow-brand"
    data-i18n="a11y.skipToContent"
  >{t('a11y.skipToContent')}</a>
  {/* 顶栏高度此前由内层胶囊的 py-3 撑开（约 48px），与其余 13 个门户的 64px 不一致。
       改为令牌高度 + flex 居中；内层胶囊用 h-full 填满**减去 py-2 后的内容盒**（48px），
       于是外框 64px、胶囊仍悬浮——保留本站的营销站观感，同时与外框节奏对齐。 */}
    <header class="sticky top-0 z-50 flex h-[var(--layout-header-height)] items-center px-3 py-2 sm:px-6">
    <div class="relative mx-auto flex max-w-7xl items-center justify-between rounded-full border border-white/70 bg-white/80 h-full px-4 shadow-soft backdrop-blur-xl dark:border-white/10 dark:bg-[var(--color-bg-primary)]/70 sm:px-6">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo-mark.svg" alt={t('layout.logoAlt')} data-i18n-alt="layout.logoAlt" class="h-10 w-10 object-contain drop-shadow-[0_8px_18px_rgba(0,49,83,0.18)]" />
        <div class="hidden sm:block">
          <div class="text-[1.9rem] font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-900 dark:text-white">Autional</div>
        </div>
      </a>
      {/* 桌面导航自 xl 起（2026-10-08）：md–lg 区间（768–1279px）七项 + 搜索文字 + 双语 + 主题
          的自然宽度超出视口（实测 768→989 / 1024→1037），整页横向溢出；该区间并入汉堡菜单 */}
      <nav class="hidden items-center gap-1 xl:flex">
        <a href="/features" class={navLinkClass} aria-current={isCurrentPath('/features') ? 'page' : undefined} data-i18n="nav.features">{t('nav.features')}</a>
        <a href="/sdk" class={navLinkClass} aria-current={isCurrentPath('/sdk') ? 'page' : undefined} data-i18n="nav.sdk">{t('nav.sdk')}</a>
        <a href="/ai" class={navLinkClass} aria-current={isCurrentPath('/ai') ? 'page' : undefined} data-i18n="nav.ai">{t('nav.ai')}</a>
        <a href="/pricing" class={navLinkClass} aria-current={isCurrentPath('/pricing') ? 'page' : undefined} data-i18n="nav.pricing">{t('nav.pricing')}</a>
        <a href="/docs" class={navLinkClass} aria-current={isCurrentPath('/docs') ? 'page' : undefined} data-i18n="nav.docs">{t('nav.docs')}</a>
        <a href="/blog" class={navLinkClass} aria-current={isCurrentPath('/blog') ? 'page' : undefined} data-i18n="nav.blog">{t('nav.blog')}</a>
        <a href={GITHUB_ORG_URL} class={navLinkClass} aria-label="GitHub" title="GitHub">
          {/* 2026-11-02：由文字改为图标，为「登录」入口腾出 ~45px（1280 英文区实测余量为 0）。 */}
          <svg class="h-[18px] w-[18px]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-2.91-.88-2.91-2.79 0-.62.22-1.13.58-1.53-.06-.14-.26-.72.06-1.5 0 0 .53-.17 1.74.65a5.9 5.9 0 0 1 1.6-.22c.54 0 1.09.07 1.6.22 1.21-.83 1.74-.65 1.74-.65.32.78.12 1.36.06 1.5.36.4.58.91.58 1.53 0 1.92-1.13 2.59-2.91 2.79.29.25.55.74.55 1.5 0 1.08-.01 1.95-.01 2.22 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
        </a>
      </nav>
      {/* 登录入口（2026-11-02）：此前只能 www → /portals → brand → auth 三跳。
          落 auth 根而不是 brand：已登录用户由 EntryRouter 直接进 /<slug>/dashboard。 */}
      <a
        href={signInUrl}
        class="ml-2 hidden rounded-full px-3 py-2 text-sm font-medium text-primary-700 transition-colors hover:bg-sky-50 dark:text-sky-100 dark:hover:bg-white/10 xl:inline-flex"
        data-i18n="nav.login"
      >{t('nav.login')}</a>
      <ClientShell client:load searchIndex={searchIndex} currentPath={currentPath} />
      {/* 头部 CTA（2026-10-08）：md 起常驻（含汉堡同行区间），<md 收进移动菜单；文案键 nav.getStarted 已备。
          ml-3（2026-10-09）：胶囊按内容宽收缩 → justify-between 空转，组间须显式间距，否则控件硬边相撞 */}
      <a href={quickstartUrl} class="brand-button-primary ml-3 hidden md:inline-flex" data-i18n="nav.getStarted">{t('nav.getStarted')}</a>
    </div>
  </header>
  <main class="flex-1" id="main-content"><slot /></main>
  <footer class="mt-12 px-4 pb-6 sm:px-6">
    <div class="mx-auto max-w-7xl rounded-xxl bg-primary-900 px-6 py-12 text-white shadow-brand sm:px-10">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-6">
        <div class="md:col-span-2">
          <a href="/" class="inline-flex items-center">
            <div class="text-[2rem] font-extrabold tracking-[var(--letter-spacing-display-lg)] text-white">Autional</div>
          </a>
          <p class="mt-5 max-w-sm text-sm leading-7 text-sky-100/82" data-i18n="footer.description">{t('footer.description')}</p>
        </div>
        <div><h3 class="text-sm font-semibold text-white" data-i18n="footer.platform">{t('footer.platform')}</h3><ul class="mt-4 space-y-3">
          <li><a href="/features" class={footerLinkClass} data-i18n="footer.features">{t('footer.features')}</a></li>
          <li><a href="/pricing" class={footerLinkClass} data-i18n="footer.pricing">{t('footer.pricing')}</a></li>
          <li><a href="/compare" class={footerLinkClass} data-i18n="footer.compare">{t('footer.compare')}</a></li>
          <li><a href="/roadmap" class={footerLinkClass} data-i18n="footer.roadmap">{t('footer.roadmap')}</a></li>
          <li><a href="/showcase" class={footerLinkClass} data-i18n="footer.showcase">{t('footer.showcase')}</a></li>
          <li><a href="/cases" class={footerLinkClass} data-i18n="footer.cases">{t('footer.cases')}</a></li>
        </ul></div>
        <div><h3 class="text-sm font-semibold text-white" data-i18n="footer.developers">{t('footer.developers')}</h3><ul class="mt-4 space-y-3">
          <li><a href="/docs" class={footerLinkClass} data-i18n="footer.docs">{t('footer.docs')}</a></li>
          <li><a href="/sdk" class={footerLinkClass} data-i18n="footer.sdk">{t('footer.sdk')}</a></li>
          <li><a href="/ai" class={footerLinkClass} data-i18n="footer.ai">{t('footer.ai')}</a></li>
        </ul></div>
        <div><h3 class="text-sm font-semibold text-white" data-i18n="footer.resources">{t('footer.resources')}</h3><ul class="mt-4 space-y-3">
          <li><a href={brotherUrl('docs')} class={footerLinkClass} data-i18n="footer.docsPortal">{t('footer.docsPortal')}</a></li>
          <li><a href={brotherUrl('developer')} class={footerLinkClass} data-i18n="footer.devPortal">{t('footer.devPortal')}</a></li>
          <li><a href={brotherUrl('reference')} class={footerLinkClass} data-i18n="footer.apiReference">{t('footer.apiReference')}</a></li>
          <li><a href={brotherUrl('wiki')} class={footerLinkClass} data-i18n="footer.apiWiki">{t('footer.apiWiki')}</a></li>
          <li><a href={brotherUrl('status')} class={footerLinkClass} data-i18n="footer.status">{t('footer.status')}</a></li>
          <li><a href="/portals" class={footerLinkClass} data-i18n="footer.allPortals">{t('footer.allPortals')}</a></li>
        </ul></div>
        <div><h3 class="text-sm font-semibold text-white" data-i18n="footer.company">{t('footer.company')}</h3><ul class="mt-4 space-y-3">
          <li><a href="/about" class={footerLinkClass} data-i18n="footer.about">{t('footer.about')}</a></li>
          <li><a href="/blog" class={footerLinkClass} data-i18n="footer.blog">{t('footer.blog')}</a></li>
          <li><a href="/faq" class={footerLinkClass} data-i18n="footer.faq">{t('footer.faq')}</a></li>
          <li><a href="/changelog" class={footerLinkClass} data-i18n="footer.changelog">{t('footer.changelog')}</a></li>
          <li><a href="/contact" class={footerLinkClass} data-i18n="footer.contact">{t('footer.contact')}</a></li>
        </ul></div>
      </div>
      <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-sky-100/68 sm:flex-row sm:items-center sm:justify-between">
        <p data-i18n="footer.copyright">{t('footer.copyright', { year })}</p>
        <div class="flex flex-wrap gap-4">
          <a href="/privacy" class="transition-colors hover:text-white" data-i18n="footer.privacy">{t('footer.privacy')}</a>
          <a href="/terms" class="transition-colors hover:text-white" data-i18n="footer.terms">{t('footer.terms')}</a>
          <a href={brotherUrl('trust')} class="transition-colors hover:text-white" data-i18n="footer.trust">{t('footer.trust')}</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // chrome 语言交换（B1-5，单源机制）：LangSwitch 调 setLang() 后广播 LANG_EVENT，
    // 本脚本把带 data-i18n / data-i18n-<attr> 的静态 chrome 节点就地重写为当前语言；
    // 页面正文与博客/列表内容保持区域默认语言（不与切换联动）——文案键来自同一份 i18n 资源。
    import i18next, { LANG_EVENT, LANG_STORAGE_KEY, i18nReady, langs, langToLocale, defaultLang, t } from '../i18n';
    import type { Lang } from '../i18n';

    const ATTRS = ['aria-label', 'alt', 'title', 'placeholder'] as const;

    const applyChrome = (translate: typeof t = t) => {
      const params = { year: new Date().getFullYear() };
      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const key = el.dataset.i18n;
        if (key) el.textContent = translate(key, params);
      });
      for (const attr of ATTRS) {
        document.querySelectorAll<HTMLElement>(`[data-i18n-${attr}]`).forEach((el) => {
          const key = el.getAttribute(`data-i18n-${attr}`);
          if (key) el.setAttribute(attr, translate(key, params));
        });
      }
    };

    window.addEventListener(LANG_EVENT, () => applyChrome());

    // 已存偏好只做 DOM 交换（getFixedT 取词），**不切 i18next.language**（2026-10-08 #418 修复）：
    // island 首渲必须与 SSR 的区域默认语言一致，否则 React 报文本不匹配（#418）；
    // i18next 本体切到偏好语言延后到 hydration 之后（ClientShell 的 useEffect → restoreLang）。
    const adoptSavedLang = (): boolean => {
      try {
        const saved = localStorage.getItem(LANG_STORAGE_KEY) as Lang | null;
        if (!saved || !langs.includes(saved)) return false;
        const locale = langToLocale(saved);
        if (locale === langToLocale(defaultLang())) return false;
        document.documentElement.lang = locale;
        applyChrome(i18next.getFixedT(locale));
        return true;
      } catch {
        return false;
      }
    };

    // 无偏好（或与区域默认一致）时兜底重写一次；有偏好时上面的 fixedT 交换已生效，不能再用全局 t 覆盖
    i18nReady.then(() => {
      if (!adoptSavedLang()) applyChrome();
    });
  </script>
</body></html>
